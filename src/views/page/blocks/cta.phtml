<?php

use src\Security\UrlPolicy;
use function NixPHP\View\s;
use function NixPHP\I18n\t;

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$buttonUrl = UrlPolicy::link((string) ($props['buttonUrl'] ?? '#')) ?? '#';
$surface = \src\Theme\Theme::slug((string) ($props['surface'] ?? 'none')) ?: 'none';
$surfaceClass = [
    'none' => 'flex flex-wrap items-center justify-between gap-5',
    'soft' => 'flex flex-wrap items-center justify-between gap-5 rounded-lg bg-[var(--page-panel-soft)] p-6',
    'card' => 'flex flex-wrap items-center justify-between gap-5 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-6',
    'accent' => 'flex flex-wrap items-center justify-between gap-5 rounded-lg border border-[color-mix(in_srgb,var(--page-accent)_36%,var(--page-card-border))] bg-[color-mix(in_srgb,var(--page-accent)_12%,var(--page-card-bg))] p-6',
][$surface] ?? 'flex flex-wrap items-center justify-between gap-5';

?>
<section class="<?= s(trim('page-block--surface-' . $surface . ' ' . $surfaceClass)) ?>">
    <div class="grid gap-2">
        <h2 class="m-0 text-2xl font-extrabold text-[var(--page-text)]"><?= s(t((string) ($props['title'] ?? 'Ready to start?'))) ?></h2>
        <p class="m-0 max-w-[70ch] text-sm leading-relaxed text-[var(--page-muted)]"><?= s(t((string) ($props['text'] ?? 'Add a clear next step for this page.'))) ?></p>
    </div>
    <a class="inline-flex min-h-10 items-center rounded-md bg-[var(--page-accent)] px-4 text-sm font-bold text-white" href="<?= s($buttonUrl) ?>"><?= s(t((string) ($props['buttonLabel'] ?? 'Continue'))) ?></a>
</section>
