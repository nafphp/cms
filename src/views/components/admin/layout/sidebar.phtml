            <span class="grid h-9 w-9 place-items-center rounded-md border border-white/10 bg-white/[.035] shadow-[inset_0_1px_0_rgba(255,255,255,.08),0_10px_24px_rgba(0,0,0,.18)] transition group-hover/toggle:border-white/18 group-hover/toggle:bg-white/[.07]" aria-hidden="true">
