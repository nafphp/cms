$renderItems = static function (array $items, int $depth = 0, string $parentKey = '') use (&$renderItems, $renderIcon, $activeMainClass, $activeChildClass): void {
    foreach ($items as $item) {
        $routeNames = is_array($item['routeNames'] ?? null) ? $item['routeNames'] : [];
        $activeClass = $routeNames !== [] ? route()->active($routeNames) : '';
        $isActive = $activeClass !== '';
        $label = (string) ($item['label'] ?? '');
        $displayLabel = t($label);
        $icon = (string) ($item['icon'] ?? 'dot');
        $key = (string) ($item['key'] ?? $label);
        $children = is_array($item['children'] ?? null) ? $item['children'] : [];
        $isRoot = $depth === 0;
        $activeClassName = $isRoot ? $activeMainClass : $activeChildClass;
        $heightClass = $isRoot ? 'min-h-12' : 'min-h-[34px]';
        $textClass = $isRoot ? 'text-sm' : 'text-[13px]';
        $paddingClass = $isRoot ? 'px-3 py-0' : 'px-2 py-2.5';
        $indentStyle = $isRoot ? '' : 'margin-left: ' . min(18 * $depth, 54) . 'px;';
        $gapClass = $isRoot ? 'gap-3' : 'gap-2';
        $submenuItemClass = '';
        $collapsedClass = $isRoot ? 'group-[.is-menu-collapsed]:justify-center group-[.is-menu-collapsed]:px-0' : '';
        ?>
        <?php if ($children !== []): ?>
            <details
                class="admin-menu-group <?= $isActive ? 'active' : '' ?>"
                <?= $indentStyle !== '' ? 'style="' . s($indentStyle) . '"' : '' ?>
                data-menu-key="<?= s($key) ?>"
                data-admin-navigation-item="<?= s($key) ?>"
                data-admin-navigation-parent="<?= s($parentKey) ?>"
                draggable="true"
                <?= $isActive ? 'open' : '' ?>
            >
                <summary class="<?= s($submenuItemClass) ?> flex <?= s($heightClass) ?> cursor-pointer list-none items-center <?= s($gapClass) ?> border-0 border-l-[3px] <?= s($paddingClass) ?> text-slate-300 transition after:ml-auto after:h-2 after:w-2 after:rotate-45 after:border-b-2 after:border-r-2 after:border-current after:opacity-60 after:content-[''] hover:bg-[rgba(86,119,164,.10)] hover:text-slate-100 group-[.is-menu-collapsed]:after:hidden <?= s($collapsedClass) ?> <?= $isActive ? $activeClassName : 'border-l-transparent' ?>" title="<?= s($displayLabel) ?>">
                    <?= $renderIcon($icon, !$isRoot) ?>
                    <span class="admin-menu-expanded-only <?= s($textClass) ?> font-normal group-[.is-menu-collapsed]:hidden"><?= s($displayLabel) ?></span>
                </summary>
                <div class="admin-menu-flyout grid gap-0 group-[.is-menu-collapsed]:hidden" data-admin-navigation-list data-admin-navigation-parent="<?= s($key) ?>">
                    <?php $renderItems($children, $depth + 1, $key); ?>
                </div>
            </details>
            <?php continue; ?>
        <?php endif; ?>
        <a
            href="<?= s((string) ($item['href'] ?? '#')) ?>"
            class="<?= s($submenuItemClass) ?> flex <?= s($heightClass) ?> items-center <?= s($gapClass) ?> border-0 border-l-[3px] <?= s($paddingClass) ?> text-slate-300 transition hover:bg-[rgba(86,119,164,.10)] hover:text-slate-100 <?= s($collapsedClass) ?> <?= $isActive ? $activeClassName : 'border-l-transparent' ?>"
            <?= $indentStyle !== '' ? 'style="' . s($indentStyle) . '"' : '' ?>
            title="<?= s($displayLabel) ?>"
            data-admin-navigation-item="<?= s($key) ?>"
            data-admin-navigation-parent="<?= s($parentKey) ?>"
            draggable="true"
        >
            <?= $renderIcon($icon, !$isRoot) ?>
            <span class="admin-menu-expanded-only <?= s($textClass) ?> font-normal text-slate-200/95 group-[.is-menu-collapsed]:hidden"><?= s($displayLabel) ?></span>
        </a>
        <?php
    }
};

