{
    "name": "fkde/nixcms",
    "description": "Lightweight extensible CMS built on NixPHP",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../nixphp-i18n"
        }
    ],
    "require": {
        "php": ">=8.3",
        "nixphp/framework": "^0.1",
        "nixphp/view": "^0.1",
        "nixphp/form": "^0.1",
        "nixphp/database": "^0.1",
        "nixphp/orm": "^0.1",
        "nixphp/session": "^0.1",
        "nixphp/i18n": "dev-v0.1.4-rc",
        "nixphp/cli": "^0.1",
        "nixphp/queue": "^0.1",
        "nixphp/schedule": "^0.1",
        "nixphp/mail": "^0.1",
        "nixphp/mcp": "^0.1"
    },
    "autoload": {
        "files": [
            "app/functions.php"
        ],
        "psr-4": {
            "NixCMS\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Flo Knapp",
            "email": "office@florianknapp.de"
        }
    ],
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
        "nix": "vendor/bin/nix",
        "test": "vendor/bin/phpunit tests"
    },
    "config": {
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    }
}
