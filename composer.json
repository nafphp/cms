{
    "name": "naf/cms",
    "description": "Fully working CMS for NAF.",
    "type": "naf-plugin",
    "keywords": [
        "naf",
        "cms",
        "content-management",
        "plugin"
    ],
    "homepage": "https://github.com/nafphp/cms",
    "support": {
        "issues": "https://github.com/nafphp/cms/issues",
        "source": "https://github.com/nafphp/cms"
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "naf/framework": "^0.2",
        "naf/view": "^0.2",
        "naf/form": "^0.2",
        "naf/database": "^0.2",
        "naf/orm": "^0.2",
        "naf/session": "^0.2",
        "naf/i18n": "^0.2",
        "naf/cli": "^0.2",
        "naf/queue": "^0.2",
        "naf/schedule": "^0.2",
        "naf/mail": "^0.2",
        "naf/mcp": "^0.2",
        "naf/auth": "^0.2"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Naf\\CMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Flo Knapp",
            "email": "office@florianknapp.de"
        }
    ],
    "scripts": {
        "test": "@php tests/run.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "process-timeout": 0
    },
    "archive": {
        "exclude": [
            "/.claude",
            "/.env*",
            "/.github",
            "/.idea",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/dev",
            "/logs",
            "/node_modules",
            "/public/.htaccess",
            "/public/css/themes",
            "/public/index.php",
            "/public/js/themes",
            "/public/router.php",
            "/storage",
            "/tests",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "phpstan/phpstan": "^2.1"
    }
}
