{
    "name": "nixphp/cms",
    "description": "Fully working CMS for NixPHP.",
    "type": "nixphp-plugin",
    "keywords": [
        "nixphp",
        "cms",
        "content-management",
        "plugin"
    ],
    "homepage": "https://github.com/nixphp/cms",
    "support": {
        "issues": "https://github.com/nixphp/cms/issues",
        "source": "https://github.com/nixphp/cms"
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "nixphp/framework": "^0.1",
        "nixphp/view": "^0.1",
        "nixphp/form": "^0.1",
        "nixphp/database": "^0.1",
        "nixphp/orm": "^0.1.3",
        "nixphp/session": "^0.1",
        "nixphp/i18n": "^0.1.3",
        "nixphp/cli": "^0.1",
        "nixphp/queue": "^0.1",
        "nixphp/schedule": "^0.1",
        "nixphp/mail": "^0.1",
        "nixphp/mcp": "^0.1",
        "nixphp/auth": "^0.1"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "NixPHP\\CMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Flo Knapp",
            "email": "office@florianknapp.de"
        }
    ],
    "scripts": {
        "test": "@php tests/run.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "process-timeout": 0
    },
    "archive": {
        "exclude": [
            "/.claude",
            "/.env*",
            "/.github",
            "/.idea",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/dev",
            "/logs",
            "/node_modules",
            "/public/.htaccess",
            "/public/css/themes",
            "/public/index.php",
            "/public/js/themes",
            "/public/router.php",
            "/storage",
            "/tests",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "phpstan/phpstan": "^2.1"
    }
}
