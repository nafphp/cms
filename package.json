{
  "name": "nafcms",
  "private": true,
  "version": "0.0.1",
  "description": "Lightweight extensible CMS built on NAF.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i ./src/Resources/css/nafcms.css -o ./public/css/nafcms.css --watch --verbose",
    "build": "tailwindcss -i ./src/Resources/css/nafcms.css -o ./public/css/nafcms.css --minify --verbose",
    "test:builder": "node --test \"tests/js/*.test.js\"",
    "test:assets": "node --test tests/assets/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "axe-core": "^4.10",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13"
  }
}
