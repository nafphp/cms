    "test:builder": "node --test tests/js/page-builder-flow.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13"
  }
}
