{
  "name": "nixcms",
  "private": true,
  "version": "0.0.1",
  "description": "Lightweight extensible CMS built on NixPHP.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i ./app/Resources/css/nixcms.css -o ./public/css/nixcms.css --watch --verbose",
