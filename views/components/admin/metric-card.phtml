<?php

use function Naf\View\s;

$label     = (string) ($label ?? '');
$value     = (string) ($value ?? '0');
$hint      = (string) ($hint ?? '');
$tone      = (string) ($tone ?? 'default');
$toneClass = $tone === 'success'
    ? 'border-emerald-200 bg-emerald-50/80 dark:border-emerald-900 dark:bg-emerald-950/30'
    : 'border-slate-200 bg-white/95 dark:border-slate-800 dark:bg-slate-900/95';

?>
<article class="rounded-lg border p-5 shadow-[0_18px_48px_rgba(15,23,42,.08)] dark:shadow-[0_22px_54px_rgba(0,0,0,.32)] <?= s($toneClass) ?>">
    <span class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400"><?= s($label) ?></span>
    <strong class="mt-2 block text-2xl font-semibold leading-none text-slate-950 dark:text-white"><?= s($value) ?></strong>
    <?php if ($hint !== ''): ?>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><?= s($hint) ?></p>
    <?php endif; ?>
</article>
