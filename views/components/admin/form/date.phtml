<?php

use function NixPHP\View\s;
use function NixPHP\CMS\View\Admin\Form\attributes;
use function NixPHP\CMS\View\Admin\Form\classes;
use function NixPHP\CMS\View\Admin\Form\field_id;
use function NixPHP\CMS\View\Admin\Form\remembered;

require_once __DIR__ . '/_helpers.php';

$name = (string) ($name ?? '');
$label = (string) ($label ?? $name);
$id = ($id ?? null) === false ? '' : field_id($name, isset($id) ? (string) $id : null);
$value = remembered($name, $value ?? '', (bool) ($useMemory ?? true));
$placeholder = (string) ($placeholder ?? 'YYYY-MM-DD');
$hideLabel = (bool) ($hideLabel ?? true);
$attributes = is_array($attributes ?? null) ? $attributes : [];
$className = classes('block min-h-11 w-full rounded-lg border border-[var(--border)] bg-admin-field py-2.5 pl-3 pr-[46px] text-sm text-[var(--text)] outline-none transition placeholder:text-slate-400 focus:border-accent focus:bg-admin-field-focus focus:shadow-[0_0_0_3px_color-mix(in_srgb,var(--admin-page-accent)_18%,transparent)]', (string) ($class ?? ''));

?>
<label class="<?= $hideLabel ? 'sr-only' : 'mb-2 inline-block text-[13px] font-semibold text-slate-500 dark:text-slate-400' ?>"<?= $id !== '' ? ' for="' . s($id) . '"' : '' ?>><?= s($label) ?></label>
<div class="relative w-full" data-date-picker>
    <input
        type="text"
        inputmode="numeric"
        pattern="\d{4}-\d{2}-\d{2}"
        placeholder="<?= s($placeholder) ?>"
        <?= $name !== '' ? 'name="' . s($name) . '"' : '' ?>
        <?= $id !== '' ? 'id="' . s($id) . '"' : '' ?>
        value="<?= s($value) ?>"
        class="<?= s($className) ?>"
        data-date-picker-input
        <?= attributes($attributes) ?>
    >
    <button class="absolute right-[5px] top-[5px] grid h-[34px] w-[34px] place-items-center rounded-md text-slate-500 hover:bg-surface-soft" type="button" data-date-picker-toggle aria-label="<?= s($label) ?>">
        <span class="relative h-[18px] w-[18px] rounded border-2 border-current before:absolute before:left-0 before:right-0 before:top-1 before:h-0.5 before:bg-current before:content-['']" aria-hidden="true"></span>
    </button>
</div>
