<?php

use Naf\CMS\Support\ScriptJson;
use Naf\View\Core\Asset;

use function Naf\View\s;

$name      = (string) ($name ?? 'content');
$label     = (string) ($label ?? 'Content');
$value     = $value ?? null;
$uploadUrl = (string) ($uploadUrl ?? '/api/admin/media/upload');
$assets    = new Asset();
$assets->add('/js/editor.js');

?>
<label class="hidden" for="editorjs"><?= s($label) ?>:</label>
<div id="editorjs" aria-placeholder="<?= s($label) ?>" class="prose prose-base min-h-[407px] max-w-none rounded-xl border border-[var(--border)] bg-admin-field px-3.5 py-[18px] text-[var(--text)] outline-none transition dark:prose-invert focus-visible:ring-2 focus-visible:ring-[var(--admin-page-accent)]"></div>
<input type="hidden" name="<?= s($name) ?>" value="">

<?= $assets->render('js') ?>
<script nonce="<?= \Naf\CMS\csp_nonce() ?>">
    const editor = new EditorJS({
        holder: 'editorjs',
        placeholder: <?= ScriptJson::encode($label) ?>,
        tools: {
            header: Header,
            list: List,
            quote: Quote,
            code: Code,
            table: Table,
            embed: Embed,
            image: {
                class: ImageTool,
                config: {
                    field: 'file',
                    endpoints: {
                        byFile: <?= ScriptJson::encode($uploadUrl) ?>,
                        byUrl: '/editor/fetch/image'
                    },
                    additionalRequestHeaders: {
                        'X-CSRF-Token': String(window.NafCMS?.csrfToken?.() || document.querySelector('input[name="_csrf"]')?.value || '')
                    },
                    additionalRequestData: {
                        _csrf: String(window.NafCMS?.csrfToken?.() || document.querySelector('input[name="_csrf"]')?.value || '')
                    }
                }
            }
        }
    });
    window.articleEditor = editor;

    <?php if ($value !== null && trim((string) $value) !== ''): ?>
        editor.isReady.then(() => {
            editor.render(<?= (string) $value ?>);
        });
    <?php endif; ?>
</script>
