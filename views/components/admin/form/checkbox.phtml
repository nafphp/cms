<?php

use function Naf\CMS\View\Admin\Form\attributes;
use function Naf\CMS\View\Admin\Form\checked as resolveChecked;
use function Naf\CMS\View\Admin\Form\classes;
use function Naf\CMS\View\Admin\Form\field_id;
use function Naf\View\s;

require_once __DIR__ . '/_helpers.php';

$name        = (string) ($name ?? '');
$label       = (string) ($label ?? $name);
$value       = (string) ($value ?? '1');
$id          = ($id ?? null) === false ? '' : field_id($name . '-' . $value, isset($id) ? (string) $id : null);
$description = trim((string) ($description ?? ''));
$isChecked   = resolveChecked($name, $value, (bool) ($checked ?? false), (bool) ($useMemory ?? true));
$attributes  = is_array($attributes ?? null) ? $attributes : [];
$className   = classes('mt-2.5 flex min-h-12 w-full cursor-pointer items-center gap-3 rounded-lg border border-[var(--border)] bg-surface-soft p-3 text-inherit', (string) ($class ?? ''));

?>
<label class="<?= s($className) ?>"<?= $id !== '' ? ' for="' . s($id) . '"' : '' ?>>
    <input
        class="h-[18px] w-[18px] accent-accent"
        <?= $id !== '' ? 'id="' . s($id) . '"' : '' ?>
        type="checkbox"
        name="<?= s($name) ?>"
        value="<?= s($value) ?>"
        <?= $isChecked ? 'checked' : '' ?>
        <?= attributes($attributes) ?>
    >
    <span class="grid min-w-0 gap-0.5">
        <span class="text-sm font-semibold text-inherit"><?= s($label) ?></span>
        <?php if ($description !== ''): ?>
            <small class="text-xs text-slate-500 dark:text-slate-400"><?= s($description) ?></small>
        <?php endif; ?>
    </span>
</label>
