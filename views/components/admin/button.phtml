<?php

use function Naf\View\s;

$label      = (string) ($label ?? '');
$href       = trim((string) ($href ?? ''));
$type       = trim((string) ($type ?? 'button'));
$variant    = trim((string) ($variant ?? 'secondary'));
$size       = trim((string) ($size ?? 'default'));
$attributes = is_array($attributes ?? null) ? $attributes : [];

$baseClass    = 'inline-flex min-h-9 items-center justify-center rounded-md border px-3 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 dark:focus:ring-offset-slate-950';
$sizeClass    = $size === 'small' ? 'min-h-8 px-2.5 text-xs' : '';
$variantClass = match ($variant) {
    'primary' => 'border-transparent bg-accent text-white hover:brightness-95',
    'danger'  => 'border-transparent bg-rose-600 text-white hover:bg-rose-700',
    'ghost'   => 'border-transparent bg-transparent text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
    default   => 'border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800',
};

$classes        = trim($baseClass . ' ' . $variantClass . ' ' . $sizeClass . ' ' . (string) ($class ?? ''));
$htmlAttributes = '';
foreach ($attributes as $name => $value) {
    if ($value === null || $value === false) {
        continue;
    }
    $htmlAttributes .= ' ' . s((string) $name);
    if ($value !== true) {
        $htmlAttributes .= '="' . s((string) $value) . '"';
    }
}

?>
<?php if ($href !== ''): ?>
    <a href="<?= s($href) ?>" class="<?= s($classes) ?>"<?= $htmlAttributes ?>><?= s($label) ?></a>
<?php else: ?>
    <button type="<?= s($type) ?>" class="<?= s($classes) ?>"<?= $htmlAttributes ?>><?= s($label) ?></button>
<?php endif; ?>
