<?php

use NixCMS\Repositories\ArticleRepository;
use function NixPHP\ORM\repo;
use function NixPHP\View\s;

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$limit = max(1, min(12, (int) ($props['limit'] ?? 5)));
$categoryId = (string) ($props['source'] ?? '') === 'category' ? (int) ($props['categoryId'] ?? 0) : 0;
$language = (string) ($props['language'] ?? 'current');
$language = $language === 'current' ? cms()->settings()->currentLanguage() : $language;

try {
    $articles = repo(ArticleRepository::class)->findPublishedWithLatestVersionByCategoryAndLanguage(
        $categoryId > 0 ? $categoryId : null,
        $limit,
        $language,
    );
} catch (Throwable) {
    $articles = [];
}

?>
<section class="grid gap-3">
    <?php foreach ($articles as $article): ?>
        <a class="grid gap-1 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-4 transition hover:border-[var(--page-accent)]" href="<?= s(str_replace('{slug}', (string) $article->getSlug(), (string) ($props['detailPath'] ?? '/articles/{slug}'))) ?>">
            <strong class="text-base font-bold text-[var(--page-text)]"><?= s((string) $article->getTitle()) ?></strong>
            <?php if ((string) $article->getTeaser() !== ''): ?>
                <span class="text-sm leading-relaxed text-[var(--page-muted)]"><?= s((string) $article->getTeaser()) ?></span>
            <?php endif; ?>
        </a>
    <?php endforeach; ?>
</section>
