<?php

use Naf\CMS\Repositories\ArticleRepository;
use Naf\CMS\Security\UrlPolicy;
use Naf\CMS\Services\Content\ArticleRenderer;
use function Naf\ORM\repo;
use function Naf\View\s;
use function Naf\CMS\cms;

/** @var ArticleRenderer|null $article */
$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$limit = max(1, min(12, (int) ($props['limit'] ?? 5)));
$source = (string) ($props['source'] ?? '');
$currentArticle = ($article ?? null) instanceof ArticleRenderer ? $article : null;
$categoryId = $source === 'category' ? (int) ($props['categoryId'] ?? 0) : 0;
if ($source === 'related' && $currentArticle?->categoryId() !== null) {
    $categoryId = $currentArticle->categoryId();
}
$language = (string) ($props['language'] ?? 'current');
$language = $language === 'current' ? ($currentArticle?->language() ?: cms()->settings()->currentLanguage()) : $language;

try {
    $articles = repo(ArticleRepository::class)->findPublishedWithLatestVersionByCategoryAndLanguage(
        $categoryId > 0 ? $categoryId : null,
        $limit,
        $language,
        $source === 'related' && $currentArticle ? [$currentArticle->articleId()] : [],
    );
} catch (Throwable) {
    $articles = [];
}

?>
<section class="grid gap-3">
    <?php foreach ($articles as $article): ?>
        <?php $detailUrl = UrlPolicy::link(str_replace('{slug}', (string) $article->getSlug(), (string) ($props['detailPath'] ?? '/articles/{slug}'))) ?? '#'; ?>
        <a class="grid gap-1 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-4 transition hover:border-[var(--page-accent)]" href="<?= s($detailUrl) ?>">
            <strong class="text-base font-bold text-[var(--page-text)]"><?= s((string) $article->getTitle()) ?></strong>
            <?php if ((string) $article->getTeaser() !== ''): ?>
                <span class="text-sm leading-relaxed text-[var(--page-muted)]"><?= s((string) $article->getTeaser()) ?></span>
            <?php endif; ?>
        </a>
    <?php endforeach; ?>
</section>
