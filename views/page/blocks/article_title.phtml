<?php

use NixPHP\CMS\Services\Content\ArticleRenderer;
use function NixPHP\View\s;

/** @var ArticleRenderer|null $article */
$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$showTeaser = (bool) ($showTeaser ?? $props['showTeaser'] ?? true);
$level = in_array(($level ?? $props['level'] ?? 'h1'), ['h1', 'h2', 'h3'], true) ? (string) ($level ?? $props['level'] ?? 'h1') : 'h1';
$class = [
    'h1' => 'text-[clamp(2rem,4vw,3.75rem)] font-black leading-[1.02]',
    'h2' => 'text-[clamp(1.7rem,3vw,2.6rem)] font-extrabold leading-tight',
    'h3' => 'text-[clamp(1.35rem,2vw,1.9rem)] font-bold leading-tight',
][$level];

?>
<?php if (($article ?? null) instanceof ArticleRenderer): ?>
    <div class="grid gap-4">
        <<?= $level ?> class="m-0 <?= s($class) ?> text-slate-950 dark:text-slate-50"><?= s($article->title()) ?></<?= $level ?>>
        <?php if ($showTeaser && $article->teaser() !== ''): ?>
            <p class="m-0 max-w-[72ch] text-lg leading-relaxed text-slate-600 dark:text-slate-300"><?= s($article->teaser()) ?></p>
        <?php endif; ?>
    </div>
<?php endif; ?>
