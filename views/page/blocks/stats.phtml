<?php

use function NixPHP\View\s;
use function NixPHP\I18n\t;

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$items = array_values(array_filter(array_map(
    static fn(mixed $item): ?array => is_array($item)
        ? ['value' => trim((string) ($item['value'] ?? '')), 'label' => trim((string) ($item['label'] ?? ''))]
        : null,
    is_array($props['stats'] ?? null) ? $props['stats'] : []
), static fn(?array $item): bool => $item !== null && ($item['value'] !== '' || $item['label'] !== '')));
if ($items === []) {
    $items = [
        ['value' => (string) ($props['valueA'] ?? '12'), 'label' => (string) ($props['labelA'] ?? 'Items')],
        ['value' => (string) ($props['valueB'] ?? '98%'), 'label' => (string) ($props['labelB'] ?? 'Quality')],
        ['value' => (string) ($props['valueC'] ?? '24/7'), 'label' => (string) ($props['labelC'] ?? 'Access')],
    ];
}
$surface = \NixPHP\CMS\Theme\Theme::slug((string) ($props['surface'] ?? 'none')) ?: 'none';
$itemClass = [
    'none' => 'py-1',
    'soft' => 'rounded-lg bg-[var(--page-panel-soft)] p-5',
    'card' => 'rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-5',
    'accent' => 'rounded-lg border border-[color-mix(in_srgb,var(--page-accent)_36%,var(--page-card-border))] bg-[color-mix(in_srgb,var(--page-accent)_12%,var(--page-card-bg))] p-5',
][$surface] ?? 'py-1';

?>
<section class="grid gap-3 md:grid-cols-[repeat(var(--stats-columns),minmax(0,1fr))]" style="--stats-columns: <?= s((string) min(max(count($items), 1), 4)) ?>;">
    <?php foreach ($items as $item): ?>
        <div class="<?= s(trim('page-block--surface-' . $surface . ' ' . $itemClass)) ?>">
            <strong class="block text-3xl font-black text-[var(--page-text)]"><?= s($item['value']) ?></strong>
            <span class="mt-1 block text-sm text-[var(--page-muted)]"><?= s(t($item['label'])) ?></span>
        </div>
    <?php endforeach; ?>
</section>
