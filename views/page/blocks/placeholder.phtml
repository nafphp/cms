<?php

use function NixPHP\View\s;

$label = (string) ($label ?? 'Content block');
$size = (string) ($size ?? 'medium');
$preview = (string) ($preview ?? 'block');
$thumbnail = (bool) ($thumbnail ?? false);
$navigationItems = is_array($navigationItems ?? null) ? $navigationItems : [];
if ($navigationItems === []) {
    $navigationItems = [
        ['label' => 'Home'],
        ['label' => 'News'],
        ['label' => 'Pages'],
    ];
}
$heightClass = $thumbnail ? ([
    'hero' => 'min-h-28',
    'large' => 'min-h-24',
    'medium' => 'min-h-20',
    'aside' => 'min-h-24',
    'small' => 'min-h-14',
][$size] ?? 'min-h-20') : ([
    'hero' => 'min-h-[220px]',
    'large' => 'min-h-40',
    'medium' => 'min-h-28',
    'aside' => 'min-h-44',
    'small' => 'min-h-24',
][$size] ?? 'min-h-28');
$paddingClass = $thumbnail ? 'p-4' : 'p-6';
$gapClass = $thumbnail ? 'gap-2' : 'gap-3';
$titleClass = $thumbnail ? 'text-sm' : 'text-lg';
$lineClass = $thumbnail ? 'h-2' : 'h-2.5';

?>
<?php if ($preview === 'navigation'): ?>
    <div class="flex min-h-16 items-center gap-4 border-b border-[var(--page-border)] bg-[var(--page-header-bg)] px-6 py-4">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-[var(--page-accent)] text-sm font-black text-white">N</span>
        <strong class="text-base font-bold text-[var(--page-header-text)]">NixCMS</strong>
        <nav class="ml-auto flex flex-wrap items-center justify-end gap-4 text-sm font-semibold text-[var(--page-muted)]" aria-label="Navigation preview">
            <?php foreach (array_slice($navigationItems, 0, 5) as $item): ?>
                <span><?= s((string) ($item['label'] ?? $item['title'] ?? $item['key'] ?? 'Item')) ?></span>
            <?php endforeach; ?>
        </nav>
    </div>
<?php elseif ($preview === 'footer'): ?>
    <div class="flex min-h-16 flex-wrap items-center justify-between gap-3 border-t border-[var(--page-border)] bg-[var(--page-footer-bg)] px-6 py-4">
        <span class="text-xs font-medium text-[var(--page-footer-text)]">Powered by NixCMS</span>
        <nav class="flex flex-wrap items-center justify-end gap-3 text-xs font-semibold text-[var(--page-footer-text)]" aria-label="Footer navigation preview">
            <?php foreach (array_slice($navigationItems, 0, 4) as $item): ?>
                <span><?= s((string) ($item['label'] ?? $item['title'] ?? $item['key'] ?? 'Item')) ?></span>
            <?php endforeach; ?>
        </nav>
    </div>
<?php elseif ($preview === 'heading'): ?>
    <div class="grid content-center <?= s($thumbnail ? 'min-h-20 p-4' : 'min-h-24 p-6') ?>">
        <span class="<?= $thumbnail ? 'text-base' : 'text-2xl' ?> font-extrabold leading-tight text-[var(--page-text)]"><?= s($label) ?></span>
    </div>
<?php elseif ($preview === 'hero'): ?>
    <section class="grid items-center <?= s($thumbnail ? 'gap-4 p-4' : 'p-6') ?>" style="grid-template-columns: minmax(0, 1fr) minmax(<?= $thumbnail ? '120px' : '190px' ?>, .58fr); gap: <?= $thumbnail ? '1rem' : 'clamp(3rem, 8vw, 5.5rem)' ?>; min-height: <?= $thumbnail ? '150px' : '250px' ?>;">
        <div class="grid <?= s($thumbnail ? 'gap-2' : 'gap-4') ?>">
            <span class="<?= $thumbnail ? 'text-lg' : 'text-3xl' ?> font-extrabold leading-tight text-[var(--page-text)]"><?= s($label) ?></span>
            <span class="block <?= s($lineClass) ?> max-w-[320px] rounded-full bg-[var(--page-border)]"></span>
            <span class="block <?= s($lineClass) ?> max-w-[220px] rounded-full bg-[var(--page-panel-soft)]"></span>
            <?php if (!$thumbnail): ?>
                <span class="mt-2 block h-9 w-28 rounded-md bg-[var(--page-accent)]"></span>
            <?php endif; ?>
        </div>
        <div class="grid place-items-center justify-self-end overflow-hidden rounded-xl border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-3 shadow-[0_16px_38px_rgba(0,0,0,.20)]" style="width: min(100%, <?= $thumbnail ? '180px' : '290px' ?>); min-height: <?= $thumbnail ? '92px' : '158px' ?>;">
            <div class="grid h-full w-full place-items-center rounded-lg border border-dashed border-[var(--page-border)] bg-[var(--page-bg)]" style="min-height: <?= $thumbnail ? '68px' : '130px' ?>; background-image: linear-gradient(135deg, color-mix(in srgb, var(--page-accent) 18%, transparent), rgba(148, 163, 184, .055) 45%, color-mix(in srgb, var(--page-bg) 90%, black));">
                <svg aria-hidden="true" class="<?= s($thumbnail ? 'h-10 w-10' : 'h-14 w-14') ?> text-[var(--page-muted)]/80" viewBox="0 0 96 96" fill="none">
                    <rect x="14" y="18" width="68" height="60" rx="8" stroke="currentColor" stroke-width="5"></rect>
                    <circle cx="34" cy="38" r="8" fill="currentColor" opacity=".55"></circle>
                    <path d="M22 68l19-20 14 14 9-10 10 16H22z" fill="currentColor" opacity=".45"></path>
                    <path d="M22 24l52 48" stroke="currentColor" stroke-width="5" stroke-linecap="round" opacity=".75"></path>
                </svg>
            </div>
        </div>
    </section>
<?php elseif ($preview === 'text'): ?>
    <div class="grid content-center <?= s($thumbnail ? 'min-h-16 p-4' : 'min-h-20 p-6') ?>">
        <p class="m-0 max-w-[58ch] text-sm leading-relaxed text-[var(--page-muted)]">
            <?= s($label) ?>
        </p>
    </div>
<?php else: ?>
<div class="<?= s($heightClass) ?> grid content-center <?= s($gapClass) ?> rounded-xl border border-[var(--page-card-border)] bg-[var(--page-card-bg)] <?= s($paddingClass) ?> shadow-[0_18px_48px_rgba(0,0,0,.24)]">
    <span class="<?= s($titleClass) ?> font-bold text-[var(--page-text)]"><?= s($label) ?></span>
    <span class="block <?= s($lineClass) ?> max-w-[460px] rounded-full bg-[var(--page-border)]"></span>
    <span class="block <?= s($lineClass) ?> max-w-[320px] rounded-full bg-[var(--page-panel-soft)]"></span>
</div>
<?php endif; ?>
