<?php

use function Naf\View\s;
use function Naf\I18n\t;

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$surface = \Naf\CMS\Theme\Theme::slug((string) ($props['surface'] ?? 'none')) ?: 'none';
$surfaceClass = [
    'none' => 'grid h-full gap-3',
    'soft' => 'grid h-full gap-3 rounded-lg bg-[var(--page-panel-soft)] p-5',
    'card' => 'grid h-full gap-3 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-5',
    'accent' => 'grid h-full gap-3 rounded-lg border border-[color-mix(in_srgb,var(--page-accent)_36%,var(--page-card-border))] bg-[color-mix(in_srgb,var(--page-accent)_12%,var(--page-card-bg))] p-5',
][$surface] ?? 'grid h-full gap-3';

?>
<article class="<?= s(trim('page-block--surface-' . $surface . ' ' . $surfaceClass)) ?>">
    <span class="grid h-10 w-10 place-items-center rounded-md bg-[var(--page-accent)] text-sm font-black text-white"><?= s((string) ($props['icon'] ?? 'N')) ?></span>
    <h3 class="m-0 text-xl font-extrabold text-[var(--page-text)]"><?= s(t((string) ($props['title'] ?? 'Feature'))) ?></h3>
    <p class="m-0 text-sm leading-relaxed text-[var(--page-muted)]"><?= s(t((string) ($props['text'] ?? 'Describe a focused benefit or capability.'))) ?></p>
</article>
