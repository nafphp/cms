<?php

require_once __DIR__ . '/_helpers/navigation.php';

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$language = (string) ($props['language'] ?? '');
$pageObject = isset($page) && is_object($page) ? $page : null;
$fallbackIdentifier = (string) ($pageObject?->meta()->extra->defaultNavigationIdentifier ?? 'main');
$items = nixcms_page_block_nav_items(
    (string) ($props['identifier'] ?? 'main'),
    $language === 'current' ? $pageObject?->language() : $language,
    $fallbackIdentifier
);
$surface = \NixPHP\CMS\Theme\Theme::slug((string) ($props['surface'] ?? 'none')) ?: 'none';
$class = [
    'none' => 'w-full',
    'soft' => 'w-full rounded-lg bg-[var(--page-panel-soft)] p-5',
    'card' => 'w-full rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-5',
    'accent' => 'w-full rounded-lg border border-[color-mix(in_srgb,var(--page-accent)_36%,var(--page-card-border))] bg-[color-mix(in_srgb,var(--page-accent)_12%,var(--page-card-bg))] p-5',
][$surface] ?? 'w-full';

?>
<div class="<?= s(trim('page-block--surface-' . $surface . ' ' . $class)) ?>">
    <?= nixcms_page_block_nav($items, (string) ($props['presentation'] ?? 'horizontal'), (string) ($props['linkStyle'] ?? 'blank'), (string) ($props['linkTheme'] ?? 'default')) ?>
</div>
