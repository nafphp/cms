<?php

use Naf\CMS\Repositories\ArticleRepository;
use Naf\CMS\Security\UrlPolicy;
use Naf\CMS\Services\Content\ArticleRenderer;

use function Naf\CMS\cms;
use function Naf\I18n\t;
use function Naf\ORM\repo;
use function Naf\View\s;

/** @var ArticleRenderer|null $article */
$content           = is_array($content ?? null) ? $content : [];
$props             = is_array($content['props'] ?? null) ? $content['props'] : [];
$title             = trim((string) ($title ?? $props['title'] ?? 'Related articles'));
$source            = (string) ($source ?? $props['source'] ?? 'category');
$limit             = max(1, min(12, (int) ($limit ?? $props['limit'] ?? 3)));
$presentationValue = $presentation ?? $props['presentation'] ?? 'cards';
$presentation      = in_array($presentationValue, ['list', 'cards', 'compact'], true) ? (string) $presentationValue : 'cards';
$detailPath        = (string) ($detailPath ?? $props['detailPath'] ?? '/articles/{slug}');
$currentArticle    = ($article ?? null) instanceof ArticleRenderer ? $article : null;
$categoryId        = $source === 'category' ? $currentArticle?->categoryId() : null;

try {
    $articles = repo(ArticleRepository::class)->findPublishedWithLatestVersionByCategoryAndLanguage(
        $categoryId,
        $limit,
        $currentArticle?->language() ?: cms()->settings()->currentLanguage(),
        $currentArticle ? [$currentArticle->articleId()] : [],
    );
} catch (Throwable) {
    $articles = [];
}

?>
<?php if ($articles !== []): ?>
    <section class="grid gap-3">
        <?php if ($title !== ''): ?>
            <h2 class="m-0 text-xl font-bold text-[var(--page-text)]"><?= s(t($title)) ?></h2>
        <?php endif; ?>
        <div class="<?= $presentation === 'cards' ? 'grid gap-3 md:grid-cols-3' : 'grid gap-2' ?>">
            <?php foreach ($articles as $related): ?>
                <?php $detailUrl = UrlPolicy::link(str_replace('{slug}', (string) $related->getSlug(), $detailPath)) ?? '#'; ?>
                <a class="<?= $presentation === 'compact' ? 'text-sm font-semibold text-[var(--page-text)] underline-offset-4 hover:underline' : 'grid gap-1 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-4 transition hover:border-[var(--page-accent)]' ?>" href="<?= s($detailUrl) ?>">
                    <strong class="text-base font-bold text-[var(--page-text)]"><?= s((string) $related->getTitle()) ?></strong>
                    <?php if ($presentation !== 'compact' && (string) $related->getTeaser() !== ''): ?>
                        <span class="text-sm leading-relaxed text-[var(--page-muted)]"><?= s((string) $related->getTeaser()) ?></span>
                    <?php endif; ?>
                </a>
            <?php endforeach; ?>
        </div>
    </section>
<?php endif; ?>
