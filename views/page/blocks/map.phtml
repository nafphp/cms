<?php

use NixPHP\CMS\Security\UrlPolicy;
use function NixPHP\View\s;
use function NixPHP\I18n\t;

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$query = trim((string) ($props['query'] ?? ''));
$embedUrl = trim((string) ($props['embedUrl'] ?? ''));
$title = trim(t((string) ($props['title'] ?? 'Map')));
$caption = trim(t((string) ($props['caption'] ?? '')));
$height = max(220, min(760, (int) ($props['height'] ?? 360)));
$url = UrlPolicy::embed($embedUrl !== '' ? $embedUrl : ($query !== '' ? 'https://www.google.com/maps?q=' . rawurlencode($query) . '&output=embed' : ''));
$linkUrl = UrlPolicy::link($query !== '' ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query) : (string) $url);

?>
<section class="grid gap-3">
    <?php if ($url !== null): ?>
        <iframe
            class="w-full rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)]"
            src="<?= s($url) ?>"
            title="<?= s($title !== '' ? $title : 'Map') ?>"
            height="<?= s((string) $height) ?>"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            sandbox="allow-forms allow-popups allow-same-origin allow-scripts"
        ></iframe>
        <?php if ($linkUrl !== null): ?>
            <a class="text-sm font-semibold text-[var(--page-accent)]" href="<?= s($linkUrl) ?>" target="_blank" rel="noopener noreferrer"><?= s($title !== '' ? $title : t('Open map')) ?></a>
        <?php endif; ?>
    <?php else: ?>
        <div class="grid min-h-56 place-items-center rounded-lg border border-dashed border-[var(--page-border)] bg-[var(--page-card-bg)] p-5 text-center text-sm text-[var(--page-muted)]">
            Enter an address, place, or map embed URL.
        </div>
    <?php endif; ?>
    <?php if ($caption !== ''): ?>
        <p class="m-0 text-sm leading-relaxed text-[var(--page-muted)]"><?= s($caption) ?></p>
    <?php endif; ?>
</section>
