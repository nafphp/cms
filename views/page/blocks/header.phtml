<?php

use function NixPHP\View\s;
use function NixPHP\View\asset;
use function NixPHP\I18n\t;
use function NixCMS\cms;

require_once __DIR__ . '/_helpers/navigation.php';

$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$logoText = trim((string) ($props['logoText'] ?? ''));
$logoText = $logoText !== '' ? $logoText : cms()->settings()->logoText();
$logoText = t($logoText);
$logoImage = trim((string) ($props['logoImage'] ?? ''));
$logoImage = $logoImage !== '' ? $logoImage : cms()->settings()->logoImage();
$pageObject = isset($page) && is_object($page) ? $page : null;
$fallbackIdentifier = (string) ($pageObject?->meta()->extra->defaultNavigationIdentifier ?? 'main');
$language = $pageObject?->language();
$items = nixcms_page_block_nav_items((string) ($props['navigationIdentifier'] ?? 'main'), $language, $fallbackIdentifier);
$hasNavigation = $items !== [];
$drawerId = 'page-mobile-navigation-' . substr(md5(($pageObject?->id() ?? 'page') . ':' . serialize($items)), 0, 10);
$showLogoMark = (bool) ($props['showLogoMark'] ?? false);
$showDivider = (bool) ($props['showDivider'] ?? false);
$dividerClass = $showDivider ? 'border-b border-[var(--page-border)]' : '';

if ($hasNavigation) {
    asset()->add('/js/page-mobile-navigation.js', 'module');
}

?>
<header class="<?= s(trim('page-site-header bg-[var(--page-header-bg)] text-[var(--page-header-text)] ' . $dividerClass)) ?>" data-page-header>
    <div class="page-template-chrome-inner flex min-h-16 items-center gap-4 px-0 py-4">
        <a class="page-site-header__brand inline-flex min-h-10 items-center gap-3 text-[var(--page-header-text)] transition hover:text-[var(--page-accent)]" href="/" aria-label="<?= s($logoText) ?>">
            <?php if ($logoImage !== ''): ?>
                <img class="h-8 w-auto" src="<?= s($logoImage) ?>" alt="">
            <?php elseif ($showLogoMark): ?>
                <span class="grid h-8 w-8 place-items-center rounded-md bg-[var(--page-accent)] text-xs font-black text-white"><?= s(mb_substr($logoText, 0, 1) ?: 'N') ?></span>
            <?php endif; ?>
            <strong class="text-base font-bold"><?= s($logoText) ?></strong>
        </a>
        <?php if ($hasNavigation): ?>
            <div class="page-site-header__navigation page-desktop-navigation ml-auto"><?= nixcms_page_block_nav($items, (string) ($props['presentation'] ?? 'horizontal'), (string) ($props['linkStyle'] ?? 'blank'), (string) ($props['linkTheme'] ?? 'default')) ?></div>
            <div class="page-mobile-navigation ml-auto" data-page-mobile-navigation>
                <?php require __DIR__ . '/_partials/mobile-navigation-drawer.phtml'; ?>
            </div>
        <?php endif; ?>
    </div>
</header>
