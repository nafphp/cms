<?php

use NixCMS\Services\Content\ArticleRenderer;
use function NixPHP\I18n\t;
use function NixPHP\View\s;

/** @var ArticleRenderer|null $article */
$content = is_array($content ?? null) ? $content : [];
$props = is_array($content['props'] ?? null) ? $content['props'] : [];
$showStatus = (bool) ($showStatus ?? $props['showStatus'] ?? false);
$showAuthor = (bool) ($showAuthor ?? $props['showAuthor'] ?? true);
$showTags = (bool) ($showTags ?? $props['showTags'] ?? true);
$surface = (string) ($props['surface'] ?? 'none');
$surface = in_array($surface, ['none', 'soft', 'card', 'accent'], true) ? $surface : 'none';
$surfaceClass = [
    'none' => 'grid gap-3 text-sm',
    'soft' => 'grid gap-3 rounded-lg bg-[var(--page-panel-soft)] p-4 text-sm',
    'card' => 'grid gap-3 rounded-lg border border-[var(--page-card-border)] bg-[var(--page-card-bg)] p-4 text-sm',
    'accent' => 'grid gap-3 rounded-lg border border-[color-mix(in_srgb,var(--page-accent)_36%,var(--page-card-border))] bg-[color-mix(in_srgb,var(--page-accent)_12%,var(--page-card-bg))] p-4 text-sm',
][$surface];

?>
<?php if (($article ?? null) instanceof ArticleRenderer): ?>
    <aside class="<?= s($surfaceClass) ?>">
        <dl class="grid gap-2">
            <?php if ($article->language() !== ''): ?>
                <div class="flex items-center justify-between gap-3">
                    <dt class="text-slate-500 dark:text-slate-400"><?= s(t('Language')) ?></dt>
                    <dd class="m-0 font-bold uppercase text-slate-900 dark:text-slate-100"><?= s($article->language()) ?></dd>
                </div>
            <?php endif; ?>
            <?php if ($article->publishedAt() !== ''): ?>
                <div class="flex items-center justify-between gap-3">
                    <dt class="text-slate-500 dark:text-slate-400"><?= s(t('Published')) ?></dt>
                    <dd class="m-0 font-semibold text-slate-900 dark:text-slate-100"><?= s($article->publishedAt()) ?></dd>
                </div>
            <?php endif; ?>
            <?php if ($showAuthor && $article->author() !== ''): ?>
                <div class="flex items-center justify-between gap-3">
                    <dt class="text-slate-500 dark:text-slate-400"><?= s(t('Author')) ?></dt>
                    <dd class="m-0 font-semibold text-slate-900 dark:text-slate-100"><?= s($article->author()) ?></dd>
                </div>
            <?php endif; ?>
            <?php if ($showStatus && $article->status() !== ''): ?>
                <div class="flex items-center justify-between gap-3">
                    <dt class="text-slate-500 dark:text-slate-400"><?= s(t('Status')) ?></dt>
                    <dd class="m-0 font-semibold text-slate-900 dark:text-slate-100"><?= s($article->status()) ?></dd>
                </div>
            <?php endif; ?>
        </dl>
        <?php if ($showTags && $article->tags() !== []): ?>
            <div class="flex flex-wrap gap-1.5 border-t border-[var(--page-card-border)] pt-3">
                <?php foreach ($article->tags() as $tag): ?>
                    <span class="rounded-full bg-surface-soft px-2 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300"><?= s($tag) ?></span>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </aside>
<?php endif; ?>
