    'none' => 'None',
    'soft' => 'Soft',
    'card' => 'Card',
    'accent' => 'Accent',
];
$css = (string) ($theme['css'] ?? ".theme-" . ($identifier !== '' ? $identifier : 'my-theme') . " {\n    --page-accent: #3f7fbd;\n}\n\n.theme-" . ($identifier !== '' ? $identifier : 'my-theme') . " .page-block--surface-card {\n    border-radius: 12px;\n}\n");
$exportIdentifier = $identifier !== '' ? $identifier : 'my-theme';
$export = "Theme::create('" . $exportIdentifier . "')\n"
    . "    ->setLabel('" . str_replace("'", "\\'", $label !== '' ? $label : 'My Theme') . "')\n"
    . "    ->addStylesheet('/css/themes/" . $exportIdentifier . ".css')";
foreach ($surfaces as $surfaceId => $surfaceLabel) {
    $export .= "\n    ->addSurface('" . $surfaceId . "', '" . str_replace("'", "\\'", (string) $surfaceLabel) . "')";
}
$export .= ";\n";
$error = trim((string) ($error ?? ''));

