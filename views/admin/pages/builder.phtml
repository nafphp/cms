use function NixPHP\route;

$templates = is_array($templates ?? null) ? $templates : [];
$contentTypes = is_array($contentTypes ?? null) ? $contentTypes : [];
$navigationChoices = is_array($navigationChoices ?? null) ? $navigationChoices : [];
$languages = is_array($languages ?? null) ? array_values($languages) : ['en'];
$defaultLanguage = (string) ($defaultLanguage ?? ($languages[0] ?? 'en'));
$initialState = is_array($initialState ?? null) ? $initialState : [];
$mode = (string) ($mode ?? 'create');
$mediaAcceptedExtensions = \cms()->media()->acceptedExtensions();
$mediaMaxUploadSize = \cms()->media()->maxUploadSize();
$canUploadMedia = \user()?->can(Permission::MEDIA_UPLOAD) === true;
$translationService = new TranslationFileService();
$translationLanguages = array_values(array_unique([
    ...$languages,
    ...\cms()->settings()->languages(),
    ...array_map(
        static fn(array $language): string => (string) ($language['code'] ?? ''),
        $translationService->languages($defaultLanguage),
    ),
]));
$translationSuggestions = [];
foreach ($translationLanguages as $language) {
    $language = \cms()->languages()->normalize((string) $language);
    if ($language === null) {
        continue;
    }

    $entries = $translationService->entries($language);
    $translationSuggestions[$language] = array_map(
        static fn(string $key, string $value): array => ['key' => $key, 'value' => $value],
        array_keys($entries),
        array_values($entries),
    );
}

