<?php

use NixPHP\CMS\Enums\Permission;
use NixPHP\CMS\Repositories\ThemeRepository;
use NixPHP\CMS\Services\Settings\TranslationFileService;
use function NixPHP\View\s;
use function NixPHP\I18n\t;
use function NixPHP\route;
use function NixPHP\CMS\cms;
use function NixPHP\CMS\user;

$templates = is_array($templates ?? null) ? $templates : [];
$contentTypes = is_array($contentTypes ?? null) ? $contentTypes : [];
$themes = is_array($themes ?? null) ? $themes : cms()->themes()->options();
$themeSurfaces = is_array($themeSurfaces ?? null) ? $themeSurfaces : cms()->themes()->surfaceOptionsByTheme();
$editableThemes = [];
$canEditThemes = user()?->can(Permission::THEMES_EDIT) === true;
if ($canEditThemes) {
    $themeRepository = new ThemeRepository();
    foreach ($themeRepository->summaries() as $themeSummary) {
        $themeRow = $themeRepository->find((int) ($themeSummary['id'] ?? 0));
        if (!is_array($themeRow)) {
            continue;
        }

        $identifier = (string) ($themeRow['identifier'] ?? '');
        if ($identifier === '') {
            continue;
        }

        $editableThemes[$identifier] = [
            'id' => (int) ($themeRow['id'] ?? 0),
            'identifier' => $identifier,
            'label' => (string) ($themeRow['label'] ?? $identifier),
            'surfaces' => is_array($themeRow['surfaces'] ?? null) ? $themeRow['surfaces'] : [],
            'css' => (string) ($themeRow['css'] ?? ''),
            'cssPath' => (string) ($themeRow['cssPath'] ?? ('/css/themes/' . $identifier . '.css')),
        ];
    }
}
$themeAssets = [];
foreach (cms()->themes()->all() as $theme) {
    $themeAssets[$theme->id()] = [
        'className' => $theme->className(),
        'stylesheets' => $theme->stylesheets(),
    ];
}
$navigationChoices = is_array($navigationChoices ?? null) ? $navigationChoices : [];
$languages = is_array($languages ?? null) ? array_values($languages) : ['en'];
$defaultLanguage = (string) ($defaultLanguage ?? ($languages[0] ?? 'en'));
$initialState = is_array($initialState ?? null) ? $initialState : [];
$mode = (string) ($mode ?? 'create');
$mediaAcceptedExtensions = cms()->media()->acceptedExtensions();
$mediaMaxUploadSize = cms()->media()->maxUploadSize();
$canUploadMedia = user()?->can(Permission::MEDIA_UPLOAD) === true;
$translationService = new TranslationFileService();
$uiLanguage = cms()->settings()->currentLanguage();
$translationLanguages = array_values(array_unique([
    ...$languages,
    ...cms()->settings()->languages(),
    ...array_map(
        static fn(array $language): string => (string) ($language['code'] ?? ''),
        $translationService->languages($defaultLanguage),
    ),
]));
$translationSuggestions = [];
foreach ($translationLanguages as $language) {
    $language = cms()->languages()->normalize((string) $language);
    if ($language === null) {
        continue;
    }

    $entries = $translationService->entries($language);
    $translationSuggestions[$language] = array_map(
        static fn(string $key, string $value): array => ['key' => $key, 'value' => $value],
        array_keys($entries),
        array_values($entries),
    );
}

$config = [
    'templates' => $templates,
    'contentTypes' => $contentTypes,
    'themes' => $themes,
    'themeAssets' => $themeAssets,
    'themeSurfaces' => $themeSurfaces,
    'editableThemes' => $editableThemes,
    'canEditThemes' => $canEditThemes,
    'themeSaveUrl' => '/api/admin/themes',
    'navigationChoices' => $navigationChoices,
    'defaultNavigationIdentifier' => (string) ($defaultNavigationIdentifier ?? ($navigationChoices[0]['identifier'] ?? 'main')),
    'languages' => $languages,
    'defaultLanguage' => $defaultLanguage,
    'uiLanguage' => $uiLanguage,
    'languageOptions' => cms()->languages()->knownOptions(),
    'translationEntries' => $translationService->entries($uiLanguage),
    'translationSuggestions' => $translationSuggestions,
    'translationEndpoint' => '/api/admin/translations/{language}',
    'translationReadEndpoint' => '/api/admin/translations/{language}',
    'saveUrl' => (string) ($saveUrl ?? '/admin/pages'),
    'layoutSaveUrl' => '/api/admin/page-layouts',
    'overviewUrl' => (string) ($overviewUrl ?? route('admin.pages')),
    'initialState' => $initialState,
    'mode' => $mode,
    'media' => [
        'urls' => [
            'list' => route('api.admin.media'),
            'upload' => route('api.admin.media.upload'),
        ],
        'acceptedExtensions' => array_values($mediaAcceptedExtensions),
        'maxUploadSize' => $mediaMaxUploadSize,
        'canUpload' => $canUploadMedia,
    ],
];

?>
