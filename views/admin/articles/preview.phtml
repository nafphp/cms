        <div class="grid gap-3">
            <h3 class="m-0 font-bold"><?= s(t('History')) ?></h3>
            <?php if ($reviewActions === []): ?>
                <p class="m-0 text-[13px] text-slate-500"><?= s(t('No review actions yet.')) ?></p>
            <?php endif; ?>
            <?php foreach ($reviewActions as $action): ?>
                <?php
                $name = trim((string) ($action['firstname'] ?? '') . ' ' . (string) ($action['lastname'] ?? ''));
                $name = $name !== '' ? $name : (string) ($action['username'] ?? 'System');
                ?>
                <div class="grid gap-1 rounded-lg border border-[var(--border)] bg-panel p-2.5">
                    <strong><?= s((string) ($action['action'] ?? '')) ?></strong>
                    <span class="text-xs text-slate-500"><?= s($name) ?> · <?= s((string) ($action['reviewed_at'] ?? '')) ?></span>
                    <?php if (trim((string) ($action['comment'] ?? '')) !== ''): ?>
                        <p class="mb-0 mt-1 text-[13px]"><?= s((string) $action['comment']) ?></p>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
