                ]) ?>
                <?= view('components.admin.form.checkbox', [
                    'name' => 'publish_article',
                    'label' => t('Publish directly on approval'),
                    'class' => 'article-toggle',
                    'attributes' => ['disabled' => !($canDirectPublish ?? false)],
                    'useMemory' => false,
                ]) ?>
                <div class="flex flex-wrap gap-2">
                    <?= view('components.admin.form.button', [
                        'label' => t('Approve'),
                        'type' => 'button',
                        'attributes' => ['data-review-action' => 'approve'],
                    ]) ?>
                    <?= view('components.admin.form.button', [
                        'label' => t('Decline'),
