<?php

use function Naf\I18n\t;
use function Naf\View\s;

$submissions = is_array($submissions ?? null) ? $submissions : [];

?>
<?php $this->setLayout('layouts.admin') ?>

<?php $this->block('content'); ?>
<section class="grid gap-3 rounded-lg border border-slate-300/70 bg-white/85 p-5 dark:border-slate-400/25 dark:bg-slate-950/50">
    <?php if ($submissions === []): ?>
        <div class="rounded-md border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700"><?= s(t('No submissions yet.')) ?></div>
    <?php endif; ?>
    <?php foreach ($submissions as $submission): ?>
        <?php $payload = is_array($submission['payload'] ?? null) ? $submission['payload'] : []; ?>
        <article class="grid gap-3 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex flex-wrap justify-between gap-3">
                <strong class="text-sm text-slate-950 dark:text-white">#<?= s((string) ($submission['id'] ?? '')) ?></strong>
                <span class="text-xs text-slate-500"><?= s((string) ($submission['created_at'] ?? '')) ?></span>
            </div>
            <dl class="grid gap-2 md:grid-cols-2">
                <?php foreach ($payload as $key => $value): ?>
                    <div class="grid gap-1 rounded-md bg-slate-50 p-3 dark:bg-slate-950">
                        <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-500"><?= s((string) $key) ?></dt>
                        <dd class="m-0 text-sm text-slate-800 dark:text-slate-200"><?= nl2br(s(is_scalar($value) ? (string) $value : json_encode($value))) ?></dd>
                    </div>
                <?php endforeach; ?>
            </dl>
        </article>
    <?php endforeach; ?>
</section>
<?php $this->endBlock('content'); ?>
