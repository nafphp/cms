<?php

use function NixPHP\I18n\t;
use function NixPHP\route;
use function NixPHP\View\s;
use function NixCMS\settings;

$active = (string) ($active ?? 'general');
$groups = settings()->groups();
$tabs = [];
foreach ($groups as $key => $group) {
    $key = (string) $key;
    $label = match ($key) {
        'general' => t('General'),
        'languages' => t('Languages'),
        'ai' => t('AI'),
        default => t((string) ($group['label'] ?? ucfirst($key))),
    };
    $href = match ($key) {
        'general' => route('admin.settings'),
        'languages' => route('admin.translations'),
        'ai' => route('admin.settings.ai'),
        default => route('admin.settings.group', ['group' => $key]),
    };

    $tabs[] = [
        'key' => $key,
        'label' => $label,
        'href' => $href,
    ];
}
$tabs[] = [
    'key' => 'audit',
    'label' => t('Audit log'),
    'href' => route('admin.settings.audit'),
];

?>
<nav class="mb-5 flex flex-wrap items-center gap-2 border-b border-slate-300/70 dark:border-slate-700" aria-label="<?= s(t('Settings sections')) ?>">
    <?php foreach ($tabs as $tab): ?>
        <?php $isActive = $active === $tab['key']; ?>
        <a
            class="inline-flex min-h-10 items-center rounded-t-lg border px-3.5 text-sm font-semibold transition <?= $isActive ? 'mb-[-1px] border-slate-300 border-b-white bg-white text-accent dark:border-slate-700 dark:border-b-slate-900 dark:bg-slate-900 dark:text-slate-50' : 'border-transparent text-slate-500 hover:bg-slate-500/10 hover:text-slate-950 dark:text-slate-300 dark:hover:text-slate-50' ?>"
            href="<?= s((string) $tab['href']) ?>"
            <?= $isActive ? 'aria-current="page"' : '' ?>
        >
            <?= s((string) $tab['label']) ?>
        </a>
    <?php endforeach; ?>
</nav>
