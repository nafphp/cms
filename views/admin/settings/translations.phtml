<script nonce="<?= \Naf\CMS\csp_nonce() ?>" type="module">
    import toast from '/js/lib/notifyJs/Modules/Toast.js';
    import prompt from '/js/lib/notifyJs/Modules/Prompt.js';
    import {initStyledSelects} from '/js/components/styledSelect.js';

    const settingsForm = document.getElementById('language-settings-form');
    const form = document.getElementById('translation-form');
    const rows = form.querySelector('[data-translation-rows]');
    const modal = document.querySelector('[data-translation-modal]');
    const modalKey = modal.querySelector('[data-translation-modal-key]');
    const modalValue = modal.querySelector('[data-translation-modal-value]');
    const modalSave = modal.querySelector('[data-save-translation-modal]');
    const language = form.dataset.language || 'en';
    const languageSaveState = settingsForm?.querySelector('[data-language-save-state]');
    const settingsEndpoint = <?= ScriptJson::encode(route('api.admin.settings.update')) ?>;
    const endpoint = <?= ScriptJson::encode('/api/admin/translations/{language}') ?>.replace('{language}', encodeURIComponent(language));
    const languageOptions = <?= ScriptJson::encode($languageOptions, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    const labels = <?= ScriptJson::encode([
        'duplicateKey'         => t('Duplicate translation key:'),
        'emptyKey'             => t('Translation keys cannot be empty.'),
        'settingsSaved'        => t('Settings saved.'),
        'settingsCouldNotSave' => t('Could not save settings.'),
        'dirty'                => t('Unsaved changes.'),
        'clean'                => t('No unsaved changes.'),
        'createLanguage'       => t('Create language'),
        'newLanguage'          => t('New language'),
        'language'             => t('Language'),
        'chooseLanguageCode'   => t('Choose a language code.'),
        'invalidLanguage'      => t('Please choose a valid language code.'),
        'languageCreated'      => t('Language created.'),
        'deleteConfirm'        => t('Delete translation?'),
        'delete'               => t('Delete'),
        'cancel'               => t('Cancel'),
        'saved'                => t('Translations saved.'),
        'couldNotSave'         => t('Could not save translations.'),
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    let activeRow = null;

    const payloadFromSettingsForm = (targetForm) => {
        const payload = {};
        for (const [key, value] of new FormData(targetForm).entries()) {
            if (key.endsWith('[]')) {
                const normalizedKey = key.slice(0, -2);
                if (!Array.isArray(payload[normalizedKey])) payload[normalizedKey] = [];
                payload[normalizedKey].push(value);
                continue;
            }

            payload[key] = value;
        }

        return payload;
    };

    const stableValue = (value) => {
        if (Array.isArray(value)) return value;
        if (value && typeof value === 'object') {
            return Object.fromEntries(Object.keys(value).sort().map((key) => [key, stableValue(value[key])]));
        }
        return value;
    };

    const stableSettingsJson = () => {
        if (!settingsForm) return '{}';
        const payload = payloadFromSettingsForm(settingsForm);
        return JSON.stringify(stableValue(payload));
    };
    let initialSettingsPayload = stableSettingsJson();

    const updateLanguageSaveState = () => {
        if (!languageSaveState) return;
        languageSaveState.textContent = stableSettingsJson() === initialSettingsPayload ? labels.clean : labels.dirty;
    };

    const clearSettingErrors = () => {
        settingsForm.querySelectorAll('[data-setting-error]').forEach((node) => {
            node.textContent = '';
            node.classList.add('hidden');
        });
    };

    const showSettingErrors = (errors) => {
        Object.entries(errors || {}).forEach(([key, messages]) => {
            const field = settingsForm.querySelector(`[data-setting-field="${CSS.escape(key)}"]`);
            const target = field?.querySelector('[data-setting-error]');
            if (!target) return;
            target.textContent = Array.isArray(messages) ? messages.join(' ') : String(messages || '');
            target.classList.remove('hidden');
        });
    };

    const escapeHtml = (value) => String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const preview = (value) => {
        const normalized = String(value || '').replace(/\s+/g, ' ').trim();
        return normalized.length > 140 ? `${normalized.slice(0, 137)}...` : normalized;
    };

    const rowKey = (row) => String(row.querySelector('input[name="key[]"]')?.value || '').trim();

    const rowValue = (row) => String(row.querySelector('[data-translation-value]')?.value || '');

    const setRowValues = (row, key, value) => {
        row.querySelector('input[name="key[]"]').value = key;
        row.querySelector('[data-translation-value]').value = value;
        row.querySelector('[data-translation-key-label]').textContent = key || <?= ScriptJson::encode(t('New translation')) ?>;
        row.querySelector('[data-translation-preview]').textContent = preview(value) || <?= ScriptJson::encode(t('Click to edit translation text.')) ?>;
        row.classList.remove('is-new');
    };

    const openModal = (row) => {
        activeRow = row;
        const key = rowKey(row);
        modalKey.value = key;
        modalKey.readOnly = key !== '';
        modalValue.value = rowValue(row);
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
        (key === '' ? modalKey : modalValue).focus();
    };

    const closeModal = () => {
        const shouldRemoveNewRow = activeRow?.classList.contains('is-new') && rowKey(activeRow) === '' && rowValue(activeRow) === '';
        if (shouldRemoveNewRow) {
            activeRow.remove();
        }
        activeRow = null;
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
    };

    const duplicateKeyExists = (key, exceptRow) => {
        for (const row of rows.querySelectorAll('[data-translation-row]')) {
            if (row === exceptRow || row.querySelector('[data-translation-delete]')?.checked) continue;
            if (rowKey(row) === key) return true;
        }
        return false;
    };

    document.querySelector('[data-add-translation]')?.addEventListener('click', () => {
        const template = document.getElementById('translation-row-template');
        rows.append(template.content.cloneNode(true));
        openModal(rows.lastElementChild);
    });

    const languageCreationOptions = (selectedLanguage = '') => [
        `<option value="" ${selectedLanguage === '' ? 'selected' : ''} disabled>${escapeHtml(labels.language)}</option>`,
        ...Object.entries(languageOptions).map(([code, label]) => `
            <option value="${escapeHtml(code)}" ${code === selectedLanguage ? 'selected' : ''}>${escapeHtml(label)} (${escapeHtml(code)})</option>
        `),
    ].join('');

    document.querySelector('[data-create-language]')?.addEventListener('click', async () => {
        let newLanguage = null;
        const promptResult = prompt(`
            <div>${escapeHtml(labels.newLanguage)}</div>
            <div class="settings-language-prompt notify-form">
                <p class="notify-form-intro">${escapeHtml(labels.chooseLanguageCode)}</p>
                <label class="notify-field">
                    <span class="notify-field-label">${escapeHtml(labels.language)}</span>
                    <select id="settings-language-code-input" data-styled-select>
                        ${languageCreationOptions()}
                    </select>
                </label>
            </div>
        `, {
            confirmButtonText: labels.createLanguage,
            cancelButtonText: labels.cancel,
            showCancelButton: true,
            confirmCallback: (promptInstance) => {
                const select = promptInstance.container.querySelector('#settings-language-code-input');
                const selected = String(select?.value || '').trim().toLowerCase();
                if (!new RegExp(String(window.NafCMS?.languagePattern || '^[a-z]{2,3}(?:-[a-z0-9]{2,4})?$')).test(selected) || selected.length > 8) {
                    toast(labels.invalidLanguage);
                    select?.focus();
                    return true;
                }

                newLanguage = selected;
                promptInstance.promise.resolve(true);
                promptInstance.remove();
                return true;
            },
        });

        window.setTimeout(() => initStyledSelects(document.querySelectorAll('.settings-language-prompt select[data-styled-select]')), 0);
        const confirmed = await promptResult;
        if (confirmed !== true || !newLanguage) return;

        const response = await (window.NafCMS?.json || fetch)(<?= ScriptJson::encode('/api/admin/translations/{language}') ?>.replace('{language}', encodeURIComponent(newLanguage)), {
            method: 'POST',
            body: JSON.stringify({entries: {}, mode: 'merge'}),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
            toast(result.reason || labels.couldNotSave);
            return;
        }

        toast(labels.languageCreated);
        window.location.href = <?= ScriptJson::encode(route('admin.translations') . '?language=') ?> + encodeURIComponent(newLanguage);
    });

    document.querySelector('[data-translation-search]')?.addEventListener('input', (event) => {
        const query = String(event.target.value || '').trim().toLowerCase();
        rows.querySelectorAll('[data-translation-row]').forEach((row) => {
            const haystack = [
                rowKey(row),
                row.querySelector('[data-translation-key-label]')?.textContent || '',
                rowValue(row),
            ].join(' ').toLowerCase();
            row.hidden = query !== '' && !haystack.includes(query);
        });
    });

    rows.addEventListener('click', async (event) => {
        const deleteButton = event.target.closest('[data-delete-translation]');
        const editButton = event.target.closest('[data-edit-translation]');
        const row = event.target.closest('[data-translation-row]');
        if (!row) return;

        if (deleteButton) {
            const confirmed = await prompt(`<div class="my-5">${escapeHtml(labels.deleteConfirm)}<br><strong>${escapeHtml(rowKey(row))}</strong></div>`, {
                confirmButtonText: labels.delete,
                cancelButtonText: labels.cancel,
                showCancelButton: true,
            });
            if (!confirmed) return;

            if (row.classList.contains('is-new')) {
                row.remove();
                return;
            }

            row.querySelector('[data-translation-delete]').checked = true;
            row.hidden = true;
            return;
        }

        if (editButton) {
            openModal(row);
        }
    });

    rows.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const row = event.target.closest('[data-translation-row]');
        if (!row) return;
        event.preventDefault();
        openModal(row);
    });

    modal.querySelectorAll('[data-close-translation-modal]').forEach((button) => {
        button.addEventListener('click', closeModal);
    });

    modalSave.addEventListener('click', () => {
        if (!activeRow) return;

        const key = String(modalKey.value || '').trim();
        const value = String(modalValue.value || '');
        if (key === '') {
            toast(labels.emptyKey);
            modalKey.focus();
            return;
        }

        if (duplicateKeyExists(key, activeRow)) {
            toast(`${escapeHtml(labels.duplicateKey)} ${escapeHtml(key)}`);
            modalKey.focus();
            return;
        }

        setRowValues(activeRow, key, value);
        closeModal();
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });

    settingsForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearSettingErrors();

        const response = await (window.NafCMS?.json || fetch)(settingsEndpoint, {
            method: 'POST',
            body: JSON.stringify(payloadFromSettingsForm(settingsForm)),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
            showSettingErrors(result.errors || {});
            toast(result.reason || labels.settingsCouldNotSave);
            return;
        }

        toast(labels.settingsSaved);
        initialSettingsPayload = stableSettingsJson();
        updateLanguageSaveState();
        window.location.reload();
    });

    settingsForm?.addEventListener('input', updateLanguageSaveState);
    settingsForm?.addEventListener('change', updateLanguageSaveState);

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const entries = {};
        for (const row of rows.querySelectorAll('[data-translation-row]')) {
            if (row.querySelector('[data-translation-delete]')?.checked) {
                continue;
            }

            const key = rowKey(row);
            const value = rowValue(row);
            if (key === '') {
                toast(labels.emptyKey);
                return;
            }

            if (Object.prototype.hasOwnProperty.call(entries, key)) {
                toast(`${escapeHtml(labels.duplicateKey)} ${escapeHtml(key)}`);
                return;
            }

            entries[key] = value;
        }

        const response = await (window.NafCMS?.json || fetch)(endpoint, {
            method: 'POST',
            body: JSON.stringify({entries}),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
            toast(result.reason || labels.couldNotSave);
            return;
        }

        toast(`${labels.saved} (${Number(result.changed || 0)})`);
        window.location.reload();
    });
</script>
<?php $this->endBlock('content'); ?>
