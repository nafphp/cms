<?php

use function Naf\View\s;

$title = trim((string) ($title ?? ''));
$subtitle = trim((string) ($subtitle ?? ''));
$variant = trim((string) ($variant ?? 'default'));

?>
<div class="grid gap-1 <?= $variant === 'compact' ? 'py-1' : '' ?>">
    <?php if ($title !== ''): ?>
        <h1 class="m-0 text-2xl font-bold text-slate-950 dark:text-white"><?= s($title) ?></h1>
    <?php endif; ?>
    <?php if ($subtitle !== ''): ?>
        <p class="m-0 max-w-3xl text-sm text-slate-500 dark:text-slate-400"><?= s($subtitle) ?></p>
    <?php endif; ?>
</div>
