<?php

use function NixPHP\route;
use function NixPHP\View\s;

$items = is_array($items ?? null) ? $items : [];

?>
<div class="admin-menu open">
    <div class="admin-menu-stack">
        <div class="admin-menu-items">
            <?php foreach ($items as $item): ?>
                <?php
                $routeNames = is_array($item['routeNames'] ?? null) ? $item['routeNames'] : [];
                $activeClass = $routeNames !== [] ? route()->active($routeNames) : '';
                ?>
                <a href="<?= s((string) ($item['href'] ?? '#')) ?>" class="<?= s($activeClass) ?>" title="<?= s((string) ($item['label'] ?? '')) ?>" aria-label="<?= s((string) ($item['label'] ?? '')) ?>">
                    <span class="admin-menu-icon admin-menu-icon-<?= s((string) ($item['icon'] ?? 'dot')) ?>" aria-hidden="true"></span>
                    <span><?= s((string) ($item['label'] ?? '')) ?></span>
                </a>
            <?php endforeach; ?>
        </div>
        <button class="admin-menu-trigger" type="button" title="Toggle menu" aria-label="Toggle menu">
            <span aria-hidden="true"></span>
        </button>
    </div>
</div>
