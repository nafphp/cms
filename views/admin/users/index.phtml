<script nonce="<?= \Naf\CMS\csp_nonce() ?>" type="module">
    import prompt from '/js/lib/notifyJs/Modules/Prompt.js';
    import toast from '/js/lib/notifyJs/Modules/Toast.js';
    import {setupActionMenus} from '/js/components/actionMenu.js';

    const roles = <?= json_encode($roleDefinitions, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    const users = <?= json_encode($users, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    const updateRolesUrl = <?= json_encode(route('api.admin.users.roles')) ?>;
    const deleteUserUrl = <?= json_encode(route('api.admin.users.delete')) ?>;
    const createInviteUrl = <?= json_encode(route('api.admin.users.invite')) ?>;
    const i18n = <?= json_encode([
        'cancel'                  => t('Cancel'),
        'couldNotCreateInvite'    => t('Could not create invite.'),
        'couldNotUpdateRoles'     => t('Could not update roles.'),
        'createInvite'            => t('Create invite'),
        'done'                    => t('Done'),
        'email'                   => t('Email'),
        'expiresInDays'           => t('Expires in days'),
        'expiryMustBeBetween'     => t('Expiry must be between 1 and 30 days.'),
        'generateInviteIntro'     => t('Generate a one-time registration link for a new account.'),
        'inviteCreated'           => t('Invite created.'),
        'inviteLinkCopied'        => t('Invite link copied.'),
        'inviteLinkCreated'       => t('Invite link created'),
        'noPermissions'           => t('No permissions'),
        'pleaseProvideValidEmail' => t('Please provide a valid email address.'),
        'pleaseSelectRole'        => t('Please select a role.'),
        'registrationLink'        => t('Registration link'),
        'role'                    => t('Role'),
        'rolesUpdated'            => t('Roles updated.'),
        'save'                    => t('Save'),
        'selectOne'               => t('Select one'),
        'showPermissions'         => t('Show permissions'),
        'validUntil'              => t('Valid until'),
        'permissionsFor'          => t('Permissions for'),
        'delete'                  => t('Delete'),
        'deleteUserFallback'      => t('this user'),
        'deleteUserIntro'         => t('This removes the account and active sessions.'),
        'couldNotDeleteUser'      => t('Could not delete user.'),
        'userDeleted'             => t('User deleted.'),
        'updateRolesFor'          => t('Update roles for'),
        'roles'                   => t('Roles'),
        'selectAtLeastOne'        => t('Select at least one'),
        'pleaseAssignRole'        => t('Please assign at least one role.'),
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;

    const escapeHtml = (value) => String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const userById = (userId) => users.find((user) => Number(user.id) === Number(userId));

    setupActionMenus(document);

    const renderPermissionList = (permissions) => {
        if (!Array.isArray(permissions) || permissions.length === 0) {
            return `<p class="notify-form-intro">${escapeHtml(i18n.noPermissions)}</p>`;
        }

        return `
            <div class="notify-role-list">
                ${permissions.map((permission) => `
                    <div class="notify-role-option">
                        <span class="notify-role-copy">
                            <span class="notify-role-name">${escapeHtml(permission)}</span>
                        </span>
                    </div>
                `).join('')}
            </div>
        `;
    };

    document.querySelector('[data-admin-table-search]')?.addEventListener('input', (event) => {
        const query = String(event.target.value || '').trim().toLowerCase();
        document.querySelectorAll('[data-user-row]').forEach((row) => {
            row.hidden = query !== '' && !row.textContent.toLowerCase().includes(query);
        });
    });

    document.querySelectorAll('[data-show-permissions]').forEach((button) => {
        button.addEventListener('click', async () => {
            const userId = Number(button.getAttribute('data-show-permissions') || 0);
            const selectedUser = userById(userId);
            if (!selectedUser) {
                return;
            }

            await prompt(`
                <div>${escapeHtml(i18n.permissionsFor)} ${escapeHtml(selectedUser.username || '')}</div>
                <div class="notify-form">${renderPermissionList(selectedUser.permissions)}</div>
            `, {
                confirmButtonText: i18n.done,
            });
        });
    });

    const postJson = async (url, payload) => {
        const response = await (window.NafCMS?.json || fetch)(url, {
            method: 'POST',
            body: JSON.stringify(payload),
        });
        const data = await response.json();
        return {ok: response.ok, data};
    };

    const renderRoleBadges = (userId, roleNames) => {
        const target = document.querySelector(`[data-user-roles="${userId}"]`);
        if (!target) {
            return;
        }

        target.innerHTML = `<div class="flex flex-wrap gap-1.5">${
            roleNames.map((role) => `<span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">${escapeHtml(role)}</span>`).join('')
        }</div>`;
    };

    document.querySelectorAll('[data-create-invite]').forEach((button) => {
        button.addEventListener('click', async () => {
            let selectedRole = '';
            let email = '';
            let expiresInDays = 7;
            const roleMarkup = roles.map((role, index) => {
                const roleName = String(role.name || '');
                const permissions = Array.isArray(role.permission_names) ? role.permission_names.join(', ') : '';
                return `
                    <label class="notify-role-option">
                        <input type="radio" name="invite-role" class="invite-role-radio notify-role-check" value="${escapeHtml(roleName)}" ${index === 0 ? 'checked' : ''}>
                        <span class="notify-role-copy">
                            <span class="notify-role-name">${escapeHtml(roleName)}</span>
                            <span class="notify-role-permissions">${escapeHtml(permissions || i18n.noPermissions)}</span>
                        </span>
                    </label>
                `;
            }).join('');

            const result = await prompt(`
                <div>${escapeHtml(i18n.createInvite)}</div>
                <div class="notify-form">
                    <p class="notify-form-intro">${escapeHtml(i18n.generateInviteIntro)}</p>
                    <div class="notify-form-grid">
                        <label class="notify-field">
                            <span class="notify-field-label">${escapeHtml(i18n.email)}</span>
                            <input id="invite-email" type="email" placeholder="editor@example.com">
                        </label>
                        <label class="notify-field">
                            <span class="notify-field-label">${escapeHtml(i18n.expiresInDays)}</span>
                            <input id="invite-expires-days" type="number" min="1" max="30" value="7">
                        </label>
                    </div>
                    <div class="notify-section-head"><span>${escapeHtml(i18n.role)}</span><span>${escapeHtml(i18n.selectOne)}</span></div>
                    <div class="notify-role-list">${roleMarkup}</div>
                </div>
            `, {
                confirmButtonText: i18n.createInvite,
                cancelButtonText: i18n.cancel,
                showCancelButton: true,
                confirmCallback: async (promptInstance) => {
                    email = String(promptInstance.container.querySelector('#invite-email')?.value || '').trim().toLowerCase();
                    expiresInDays = Number(promptInstance.container.querySelector('#invite-expires-days')?.value || 0);
                    selectedRole = String(promptInstance.container.querySelector('.invite-role-radio:checked')?.value || '');

                    if (!email || !email.includes('@')) {
                        toast(i18n.pleaseProvideValidEmail);
                        return false;
                    }
                    if (!Number.isInteger(expiresInDays) || expiresInDays < 1 || expiresInDays > 30) {
                        toast(i18n.expiryMustBeBetween);
                        return false;
                    }
                    if (!selectedRole) {
                        toast(i18n.pleaseSelectRole);
                        return false;
                    }

                    promptInstance.promise.resolve(true);
                    promptInstance.remove();
                    return true;
                },
            });

            if (result !== true) {
                return;
            }

            const response = await postJson(createInviteUrl, {
                email,
                expiresInDays,
                roles: [selectedRole],
            });
            if (!response.ok || !response.data.success) {
                toast(response.data.reason || i18n.couldNotCreateInvite);
                return;
            }

            const invitePath = String(response.data.inviteLink || '');
            const inviteUrl = invitePath.startsWith('http') ? invitePath : `${window.location.origin}${invitePath}`;
            try {
                await navigator.clipboard.writeText(inviteUrl);
                toast(i18n.inviteLinkCopied);
            } catch (_error) {
                toast(i18n.inviteCreated);
            }

            await prompt(`
                <div>${escapeHtml(i18n.inviteLinkCreated)}</div>
                <div class="notify-form">
                    <p class="notify-form-intro">${escapeHtml(i18n.validUntil)} ${escapeHtml(String(response.data.expiresAt || ''))}</p>
                    <label class="notify-field">
                        <span class="notify-field-label">${escapeHtml(i18n.registrationLink)}</span>
                        <input type="text" readonly value="${escapeHtml(inviteUrl)}">
                    </label>
                </div>
            `, {
                confirmButtonText: i18n.done,
            });
        });
    });

    document.querySelectorAll('[data-edit-roles]').forEach((button) => {
        button.addEventListener('click', async () => {
            const userId = Number(button.getAttribute('data-edit-roles') || 0);
            const selectedUser = userById(userId);
            if (!selectedUser) {
                return;
            }

            const currentRoles = Array.isArray(selectedUser.roles) ? selectedUser.roles : [];
            let selectedRoles = [...currentRoles];
            const roleMarkup = roles.map((role) => {
                const roleName = String(role.name || '');
                const checked = currentRoles.includes(roleName) ? 'checked' : '';
                const permissions = Array.isArray(role.permission_names) ? role.permission_names.join(', ') : '';
                return `
                    <label class="notify-role-option">
                        <input type="checkbox" class="role-checkbox notify-role-check" value="${escapeHtml(roleName)}" ${checked}>
                        <span class="notify-role-copy">
                            <span class="notify-role-name">${escapeHtml(roleName)}</span>
                            <span class="notify-role-permissions">${escapeHtml(permissions || i18n.noPermissions)}</span>
                        </span>
                    </label>
                `;
            }).join('');

            const result = await prompt(`
                <div>${escapeHtml(i18n.updateRolesFor)} ${escapeHtml(selectedUser.username || '')}</div>
                <div class="notify-form">
                    <div class="notify-section-head"><span>${escapeHtml(i18n.roles)}</span><span>${escapeHtml(i18n.selectAtLeastOne)}</span></div>
                    <div class="notify-role-list">${roleMarkup}</div>
                </div>
            `, {
                confirmButtonText: i18n.save,
                cancelButtonText: i18n.cancel,
                showCancelButton: true,
                confirmCallback: async (promptInstance) => {
                    selectedRoles = Array.from(promptInstance.container.querySelectorAll('.role-checkbox:checked'))
                        .map((checkbox) => checkbox.value);
                    if (selectedRoles.length === 0) {
                        toast(i18n.pleaseAssignRole);
                        return false;
                    }
                    promptInstance.promise.resolve(true);
                    promptInstance.remove();
                    return true;
                },
            });

            if (result !== true) {
                return;
            }

            const response = await postJson(updateRolesUrl, {userId, roles: selectedRoles});
            if (!response.ok || !response.data.success) {
                toast(response.data.reason || i18n.couldNotUpdateRoles);
                return;
            }

            const updatedUser = response.data.user || {};
            selectedUser.roles = Array.isArray(updatedUser.roles) ? updatedUser.roles : selectedRoles;
            selectedUser.permissions = Array.isArray(updatedUser.permissions) ? updatedUser.permissions : [];
            renderRoleBadges(userId, selectedUser.roles);
            const permissionsTarget = document.querySelector(`[data-user-permissions="${userId}"]`);
            if (permissionsTarget) {
                permissionsTarget.textContent = selectedUser.permissions.length ? i18n.showPermissions : i18n.noPermissions;
                permissionsTarget.setAttribute('title', selectedUser.permissions.length ? selectedUser.permissions.join(', ') : i18n.noPermissions);
            }
            toast(i18n.rolesUpdated);
        });
    });

    document.querySelectorAll('[data-delete-user]').forEach((button) => {
        button.addEventListener('click', async () => {
            const userId = Number(button.getAttribute('data-delete-user') || 0);
            const selectedUser = userById(userId);
            if (!selectedUser) {
                return;
            }

            const confirmed = await prompt(
                `<div>${escapeHtml(i18n.delete)} ${escapeHtml(selectedUser.username || i18n.deleteUserFallback)}?</div><p class="mt-2 text-sm text-slate-500">${escapeHtml(i18n.deleteUserIntro)}</p>`,
                {confirmButtonText: i18n.delete, cancelButtonText: i18n.cancel, showCancelButton: true}
            );
            if (confirmed === false) {
                return;
            }

            const response = await postJson(deleteUserUrl, {userId});
            if (!response.ok || !response.data.success) {
                toast(response.data.reason || i18n.couldNotDeleteUser);
                return;
            }

            document.querySelector(`[data-user-row="${userId}"]`)?.remove();
            toast(i18n.userDeleted);
        });
    });
</script>
<?php $this->endBlock('content'); ?>
