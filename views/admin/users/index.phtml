$users = is_array($users ?? null) ? $users : [];
$roleDefinitions = is_array($roleDefinitions ?? null) ? $roleDefinitions : [];

?>
<?php $this->setLayout('layouts.admin') ?>

<?php $pageTitle = 'Benutzerverwaltung'; ?>
<?php $pageSubtitle = 'Benutzer einladen und Rollen verwalten.'; ?>

<?php $this->block('content'); ?>
