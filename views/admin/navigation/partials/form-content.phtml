            <h2 class="text-base font-semibold text-slate-950 dark:text-white"><?= s(t('Items')) ?></h2>
            <button class="inline-flex min-h-9 items-center rounded-md border border-slate-300 px-3 text-sm font-semibold text-slate-700 transition hover:border-[var(--admin-page-accent)] hover:text-slate-950 dark:border-slate-700 dark:text-slate-200 dark:hover:text-white" type="button" data-add-root>
                <?= s(t('Add item')) ?>
            </button>
