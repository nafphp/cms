<?php

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Naf\CMS\cms;

$navigation = is_array($navigation ?? null) ? $navigation : null;
$translations = is_array($translations ?? null) ? $translations : [];
$translationSuggestions = is_array($translationSuggestions ?? null) ? $translationSuggestions : [];
$languages = is_array($languages ?? null) ? array_values(array_map('strval', $languages)) : ['de', 'en'];
$pageChoices = is_array($pageChoices ?? null) ? $pageChoices : [];
$mode = (string) ($mode ?? 'create');
$endpoint = $mode === 'edit' && isset($navigation['id'])
    ? route('admin.navigation.edit', ['navigationId' => (int) $navigation['id']])
    : route('admin.navigation.create');

$ids = [];
$items = is_array($navigation['items'] ?? null) ? $navigation['items'] : [];
$preferredLanguage = strtolower(trim((string) ($navigation['language'] ?? '')));
foreach ($translations as $language => $translation) {
    if (!is_array($translation)) {
        continue;
    }
    $language = strtolower(trim((string) $language));
    $ids[$language] = (int) ($translation['id'] ?? 0);

    $translationItems = is_array($translation['items'] ?? null) ? $translation['items'] : [];
    if ($items === [] || $language === '' || ($preferredLanguage !== '' && $language === $preferredLanguage)) {
        $items = $translationItems;
    }
}

$payload = [
    'id' => (int) ($navigation['id'] ?? 0),
    'title' => (string) ($navigation['title'] ?? ''),
    'identifier' => (string) ($navigation['identifier'] ?? ''),
    'originalIdentifier' => (string) ($navigation['identifier'] ?? ''),
    'status' => (string) ($navigation['status'] ?? 'draft'),
    'ids' => $ids,
    'items' => $items,
    'translationLanguage' => cms()->settings()->currentLanguage(),
];

$languageLabels = cms()->languages()->knownOptions();
foreach ($languages as $language) {
    $language = cms()->languages()->normalize((string) $language);
    if ($language !== null) {
        $languageLabels[$language] ??= cms()->languages()->label($language);
    }
}

?>
<?php $this->setLayout('layouts.admin') ?>

<?php $this->block('content'); ?>
<form
    id="navigation-form"
    class="grid gap-5"
    data-endpoint="<?= s($endpoint) ?>"
    data-navigation="<?= s(json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR)) ?>"
    data-pages="<?= s(json_encode($pageChoices, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR)) ?>"
    data-translation-suggestions="<?= s(json_encode($translationSuggestions, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR)) ?>"
>
