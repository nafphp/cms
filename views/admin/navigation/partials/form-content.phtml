                <span class="hidden text-sm text-rose-600 dark:text-rose-300" data-error-for="title"></span>
            </label>
            <label class="grid gap-2">
                <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400"><?= s(t('Identifier')) ?></span>
                <input class="min-h-11 rounded-md border border-slate-300 bg-white px-3 font-mono text-sm text-slate-950 outline-none transition focus:border-[var(--admin-page-accent)] dark:border-slate-700 dark:bg-slate-900 dark:text-white" name="identifier" value="<?= s($payload['identifier']) ?>" placeholder="main-navigation" required>
                <span class="hidden text-sm text-rose-600 dark:text-rose-300" data-error-for="identifier"></span>
            </label>
        </div>
    </section>

    <section class="grid gap-4 rounded-lg border border-slate-300/70 bg-white/85 p-5 shadow-[0_16px_34px_rgba(15,23,42,.08)] dark:border-slate-400/25 dark:bg-slate-950/50 dark:shadow-none">
