        <div class="grid gap-4 lg:grid-cols-[1fr_300px]">
            <label class="grid gap-2">
                <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400"><?= s(t('Title')) ?></span>
