            <button class="inline-flex min-h-10 items-center rounded-md bg-[var(--admin-page-accent)] px-4 text-sm font-bold text-white transition hover:brightness-110" type="submit"><?= s(t('Save draft')) ?></button>
        </div>
    </div>
</form>

