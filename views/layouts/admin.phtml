<?php

use NixCMS\Services\Admin\AdminNavigationService;
use function NixPHP\Form\csrf;
use function NixPHP\request;
use function NixPHP\Session\session;
use function NixPHP\View\s;
use function NixPHP\View\view;

$navigationService = new AdminNavigationService();
$path = request()->getUri()->getPath();
$accent = $navigationService->accentForPath($path);
$navItems = $navigationService->items();
$csrfToken = session()->get('_csrf');
if (!is_string($csrfToken) || $csrfToken === '') {
    $csrfToken = csrf()->generate();
}

$assetWithVersion = static function (string $publicPath): string {
    $file = dirname(__DIR__, 2) . '/public/' . ltrim($publicPath, '/');
    $version = is_file($file) ? filemtime($file) : null;
    return is_int($version) ? $publicPath . '?v=' . $version : $publicPath;
};

?>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= s($title ?? 'Admin') ?> | NixCMS</title>
    <script>
        (function () {
            const root = document.documentElement;
            const storedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const useDark = storedTheme === 'dark' || (storedTheme !== 'light' && prefersDark);
            root.classList.toggle('dark', useDark);
            root.style.colorScheme = useDark ? 'dark' : 'light';
        })();
    </script>
    <link rel="stylesheet" href="<?= s($assetWithVersion('/css/icomoon.css')) ?>">
    <link rel="stylesheet" href="<?= s($assetWithVersion('/css/notify.css')) ?>">
    <link rel="stylesheet" href="<?= s($assetWithVersion('/css/nixcms.css')) ?>">
    <script>
        const nixCmsCsrfToken = <?= json_encode($csrfToken) ?>;
        window.NixCMS = {
            ...(window.NixCMS || {}),
            csrfToken: () => nixCmsCsrfToken,
            csrfHeader: 'X-CSRF-Token',
        };
    </script>
    <script>
        window.NotifyJsConfig = {
            ...(window.NotifyJsConfig || {}),
            animation: 'pop',
            theme: {
                ...((window.NotifyJsConfig || {}).theme || {}),
                accent: <?= json_encode($accent) ?>,
            },
            overlay: {
                mode: 'blur',
                opacity: 0.56,
                blur: '8px',
                ...((window.NotifyJsConfig || {}).overlay || {}),
            },
        };
    </script>
</head>
<body class="admin-app">
<div class="admin-layout">
    <?= view('components.admin.layout.sidebar', ['items' => $navItems]) ?>

    <div class="admin-main-shell" style="--admin-page-accent: <?= s($accent) ?>;">
        <?= view('components.admin.layout.topbar', [
            'title' => (string) ($pageTitle ?? $title ?? 'Admin'),
            'subtitle' => (string) ($pageSubtitle ?? ''),
        ]) ?>

        <main class="admin-content">
            <?php $adminTop = trim((string) $this->renderBlock('adminTop')); ?>
            <?php if ($adminTop !== ''): ?>
                <section class="admin-panel admin-panel-compact">
                    <?= $adminTop ?>
                </section>
            <?php endif; ?>
            <section class="admin-panel">
                <?= $this->renderBlock('content') ?>
            </section>
        </main>
    </div>
</div>
<script src="<?= s($assetWithVersion('/js/admin.js')) ?>" type="module"></script>
</body>
</html>
