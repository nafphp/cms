	        <?= view('components.admin.layout.sidebar', ['items' => $navItems]) ?>
	    <script nonce="<?= \Naf\CMS\csp_nonce() ?>">
	        (function () {
	            const root = document.documentElement;
	            const layout = document.querySelector('.admin-layout');
	            const menu = document.querySelector('.admin-menu');
	            const isCollapsed = root.classList.contains('admin-menu-collapsed');
	            if (layout) {
	                layout.classList.toggle('is-menu-collapsed', isCollapsed);
	            }
		            if (menu) {
		                menu.classList.toggle('open', !isCollapsed);
		            }

		            try {
		                const userKey = String(window.NafCMS?.adminUserKey || 'guest').replace(/[^a-zA-Z0-9:._-]/g, '_');
		                const storedOrder = JSON.parse(localStorage.getItem(`nafcms:admin-navigation-order:v1:${userKey}`) || 'null');
		                const groups = storedOrder && typeof storedOrder.groups === 'object' && storedOrder.groups !== null
		                    ? storedOrder.groups
		                    : {};
		                const lists = [...document.querySelectorAll('[data-admin-navigation-list]')];
		                const directItems = (list) => [...list.children].filter((element) => (
		                    element instanceof HTMLElement
		                    && element.matches('[data-admin-navigation-item]')
		                ));
		                const itemKey = (item) => String(item.dataset.adminNavigationItem || '');
		                const listForParent = (key) => lists.find((list) => String(list.dataset.adminNavigationParent || '') === key) || null;

		                Object.entries(groups).forEach(([parent, order]) => {
		                    if (!Array.isArray(order)) {
		                        return;
		                    }

		                    const list = listForParent(String(parent));
		                    if (!(list instanceof HTMLElement)) {
		                        return;
		                    }

		                    const items = directItems(list);
		                    const itemsByKey = new Map(items.map((item) => [itemKey(item), item]));
		                    const orderedKeys = order.map((key) => String(key));
		                    const orderedItems = orderedKeys
		                        .map((key) => itemsByKey.get(key))
		                        .filter((item) => item instanceof HTMLElement);
		                    const newItems = items.filter((item) => !orderedKeys.includes(itemKey(item)));

		                    [...orderedItems, ...newItems].forEach((item) => list.appendChild(item));
		                });
		            } catch (e) {}

		            document.querySelectorAll('.admin-menu-group[data-menu-key]').forEach((group) => {
		                const key = group instanceof HTMLElement ? group.dataset.menuKey || '' : '';
	                if (key === '') {
	                    return;
	                }
	                const isActive = group.classList.contains('active') || group.querySelector('.active') !== null;
	                if (isActive) {
	                    group.open = true;
	                    return;
	                }
	                try {
	                    const stored = localStorage.getItem(`admin_submenu_${key}`);
	                    if (stored === 'open') {
	                        group.open = true;
	                    } else if (stored === 'closed') {
	                        group.open = false;
	                    }
	                } catch (e) {}
	            });

	        })();
	    </script>

