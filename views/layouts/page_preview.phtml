<?php

use NixPHP\View\Core\Asset;
use function NixPHP\View\s;
use function NixPHP\CMS\cms;

/** @var string|null $content */
/** @var \NixPHP\CMS\Page\Page $page */
/** @var \NixPHP\CMS\Page\Template $template */
/** @var string|null $title */

$settings = cms()->settings();
$template = ($template ?? null) instanceof \NixPHP\CMS\Page\Template ? $template : \NixPHP\CMS\Page\Template::create();
$currentLanguage = $page->language() ?? $settings->currentLanguage();
$assets = new Asset();
$stylesheetTags = [];

$attributeString = static function (array $attributes): string {
    $html = '';

    foreach ($attributes as $name => $value) {
        if ($value === true) {
            $html .= ' ' . s((string) $name);
            continue;
        }

        $html .= ' ' . s((string) $name) . '="' . s((string) $value) . '"';
    }

    return $html;
};

$bodyAttributes = $page->bodyAttributes();
$htmlAttributes = $page->htmlAttributes();
$htmlAttributes['class'] = trim(($htmlAttributes['class'] ?? '') . ' dark');
$templateThemeId = trim((string) $template->themeId());
$theme = cms()->themes()->resolve($templateThemeId !== '' && $templateThemeId !== 'inherit' ? $templateThemeId : $page->themeId());
$accent = trim((string) ($page->meta()->theme->accent ?? ''));
$themeStyles = [];
if (preg_match('/^#[0-9a-fA-F]{6}$/', $accent) === 1) {
    $themeStyles[] = '--page-accent: ' . $accent;
}
$headerBackground = trim((string) ($page->meta()->theme->headerBackground ?? ''));
if (($page->meta()->theme->headerBackgroundTransparent ?? true) === true) {
    $themeStyles[] = '--page-header-bg: transparent';
} elseif (preg_match('/^#[0-9a-fA-F]{6}$/', $headerBackground) === 1) {
    $themeStyles[] = '--page-header-bg: ' . $headerBackground;
}
$footerBackground = trim((string) ($page->meta()->theme->footerBackground ?? ''));
if (($page->meta()->theme->footerBackgroundTransparent ?? false) === true) {
    $themeStyles[] = '--page-footer-bg: transparent';
} elseif (preg_match('/^#[0-9a-fA-F]{6}$/', $footerBackground) === 1) {
    $themeStyles[] = '--page-footer-bg: ' . $footerBackground;
}
$templateDefaultWidth = match ($template->view()) {
    'page.templates.default', 'page.templates.full_bleed' => '100%',
    'page.templates.article_detail' => '820px',
    'page.templates.editorial' => '1040px',
    'page.templates.landing', 'page.templates.feature_grid' => '1120px',
    'page.templates.two_column' => '960px',
    default => '1120px',
};
$themeStyles[] = '--page-template-default-width: ' . $templateDefaultWidth;
$contentWidth = match ((string) ($page->meta()->theme->contentWidth ?? '')) {
    'narrow' => '760px',
    'comfortable' => '960px',
    'wide' => '1120px',
    'full' => '100%',
    default => '',
};
if ($contentWidth !== '') {
    $themeStyles[] = '--page-content-max-width: ' . $contentWidth;
}
$bodyClasses = trim(implode(' ', [
    'page-theme',
    $theme->className(),
    $page->meta()->theme->headerContentWidthIncludesChrome ? 'page-theme--bounded-header-content' : '',
    $page->meta()->theme->headerBackgroundWidthIncludesChrome ? 'page-theme--bounded-header-background' : '',
    $page->meta()->theme->footerContentWidthIncludesChrome ? 'page-theme--bounded-footer-content' : '',
    $page->meta()->theme->footerBackgroundWidthIncludesChrome ? 'page-theme--bounded-footer-background' : '',
    ...$template->bodyClasses(),
    ...$page->bodyClasses(),
]));
if ($bodyClasses !== '') {
    $bodyAttributes['class'] = trim(($bodyAttributes['class'] ?? '') . ' ' . $bodyClasses);
}
if ($themeStyles !== []) {
    $style = trim((string) ($bodyAttributes['style'] ?? ''));
    $bodyAttributes['style'] = trim($style . ($style !== '' && !str_ends_with($style, ';') ? '; ' : ' ') . implode('; ', $themeStyles));
}

$seenStylesheets = [];
foreach ([...$template->stylesheets(), ...$theme->stylesheets(), ...$page->stylesheets()] as $stylesheet) {
    $key = $stylesheet['href'] . '|' . json_encode($stylesheet['attributes']);
    if (isset($seenStylesheets[$key])) {
        continue;
    }
    $seenStylesheets[$key] = true;

    if ($stylesheet['attributes'] === []) {
        $assets->add($stylesheet['href']);
        continue;
    }

    $stylesheetTags[] = $stylesheet;
}

?>
<!doctype html>
<html lang="<?= s($currentLanguage) ?>"<?= $attributeString($htmlAttributes) ?>>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= s($settings->pageTitle((string) ($title ?? ''))) ?></title>
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            overflow: hidden;
        }
    </style>
    <?= $assets->render('css') ?>
    <?php foreach ($stylesheetTags as $stylesheet): ?>
        <link rel="stylesheet" href="<?= s($stylesheet['href']) ?>"<?= $attributeString($stylesheet['attributes']) ?>>
    <?php endforeach; ?>
</head>
<body<?= $attributeString($bodyAttributes) ?>>
    <?= $this->renderBlock('content', $content ?? '') ?>
</body>
</html>
