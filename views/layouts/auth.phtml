<?php

declare(strict_types=1);

use function NixPHP\View\s;
use function NixPHP\I18n\t;

$settings = cms()->settings();
$currentLanguage = $settings->currentLanguage();
$assetWithVersion = static function (string $publicPath): string {
    $file = dirname(__DIR__, 2) . '/public/' . ltrim($publicPath, '/');
    $version = is_file($file) ? filemtime($file) : null;
    return is_int($version) ? $publicPath . '?v=' . $version : $publicPath;
};

?>
<!doctype html>
<html lang="<?= s($currentLanguage) ?>" class="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= s($settings->pageTitle((string) ($title ?? t('Login')))) ?></title>
    <script>
        (function () {
            const root = document.documentElement;
            let storedTheme = null;
            try {
                storedTheme = localStorage.getItem('theme');
            } catch (e) {}
            const useDark = storedTheme !== 'light';
            root.classList.toggle('dark', useDark);
            root.style.colorScheme = useDark ? 'dark' : 'light';
        })();
    </script>
    <link rel="stylesheet" href="<?= s($assetWithVersion('/css/nixcms.css')) ?>">
</head>
<body class="grid min-h-screen place-items-center bg-slate-50 p-8 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
<main class="flex min-h-screen items-center justify-center px-4">
    <?= $this->renderBlock('content') ?>
</main>
</body>
</html>
