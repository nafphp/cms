#!/usr/bin/env php
<?php

declare(strict_types=1);

error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);

$root = dirname(__DIR__);
$target = $root . '/vendor/bin/nix';

if (!is_file($target)) {
    fwrite(STDERR, "NixPHP CLI not found. Run composer install first.\n");
    exit(1);
}

chdir($root);

require $target;
