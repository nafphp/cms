#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$autoload = $root . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "NixPHP CLI not found. Run composer install first.\n");
    exit(1);
}

chdir($root);

require $root . '/dev/bootstrap.php';

$registry = \NixPHP\app()->container()->get(\NixPHP\CLI\Support\CommandRegistry::class);
$console = new \NixPHP\CLI\Core\Console($registry);
$console->run($argv);
